# Sanity (CMS) — create project at https://sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Supabase (contact form leads) — create project at https://supabase.com/dashboard
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Web Analytics — dashboard → Analytics & Logs → Web Analytics → your site.
# Public identifier, not a secret: it ships in the HTML of every page. Leave blank to skip
# the beacon entirely (which is what you want locally, so dev traffic stays out of the data).
# Must also be set as a build variable in the Cloudflare Workers project, or production
# builds silently ship without analytics.
PUBLIC_CF_BEACON_TOKEN=

# --- Vista previa visual (solo el despliegue de preview, nunca producción) ---
# El despliegue de vista previa es este mismo repositorio construido como un segundo Worker
# de Cloudflare. Al activarse, el sitio pasa a renderizar en servidor, lee borradores y emite
# marcadores stega. Esos marcadores NO pueden llegar al HTML público: acabarían dentro de la
# meta descripción, el JSON-LD y los enlaces tel:. Dejar vacío en producción y en local.
PUBLIC_SANITY_PREVIEW=
# Token de Sanity con rol **viewer** (solo lectura). Obligatorio si PUBLIC_SANITY_PREVIEW=true:
# sin él la vista previa mostraría solo contenido publicado, que es justo lo que no sirve.
# Queda incrustado en el bundle del servidor del preview, nunca en el del cliente.
SANITY_VIEWER_TOKEN=
# Origen desde el que el Studio carga la vista previa. Se lee al construir el Studio, que va
# en producción. Sin definir, apunta al servidor de desarrollo local.
PUBLIC_SANITY_PREVIEW_ORIGIN=
