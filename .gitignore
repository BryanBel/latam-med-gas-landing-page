# build output
dist/
# generated types
.astro/
# wrangler local state
.wrangler/
# supabase CLI local state (linked project ref, etc.)
supabase/.temp/
# sanity CLI local state, written by `npx sanity dev`
.sanity/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables — every variant, not only the two names this repo happens to use.
# `.dev.vars` is where Wrangler keeps local Worker secrets.
.env*
!.env.example
.dev.vars*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
