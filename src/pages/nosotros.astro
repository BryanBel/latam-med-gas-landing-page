---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import MissionVision from '../components/MissionVision.astro';
import Certifications from '../components/Certifications.astro';
import ContactCta from '../components/ContactCta.astro';
import Slogan from '../components/Slogan.astro';
import PageBlocks from '../components/PageBlocks.astro';
import SanityImage from '../components/SanityImage.astro';
import aboutCorridor from '../assets/photos/about-corridor.webp';
import { getSiteSettings, getAboutSection, getCertifications, getPage, sectionOf } from '../lib/sanityQueries';
import { DEFAULT_ABOUT, DEFAULT_PAGES, pageSeo } from '../lib/content';
import { accentFor } from '../lib/icons';
import { ShieldCheck, Globe2, Award, BadgeCheck } from 'lucide-react';

let settings = null;
let about = null;
let certifications: Awaited<ReturnType<typeof getCertifications>> = [];
let page: Awaited<ReturnType<typeof getPage>> = null;
try {
  [settings, about, certifications, page] = await Promise.all([
    getSiteSettings(),
    getAboutSection(),
    getCertifications(),
    getPage('nosotros'),
  ]);
} catch (err) {
  console.warn('[Sanity] falling back to seed content:', err);
}

const seed = DEFAULT_PAGES.nosotros;
const seo = pageSeo('nosotros', page);
const heading = page?.heroTitle ?? about?.heading ?? DEFAULT_ABOUT.heading;
const misionVisionHeading = sectionOf(page, 'misionVision').heading ?? seed.sections?.misionVision?.heading;
const certificacionesHeading = sectionOf(page, 'certificaciones').heading ?? seed.sections?.certificaciones?.heading;
const body = about?.body ?? DEFAULT_ABOUT.body;
const highlights = about?.highlights?.length ? about.highlights : DEFAULT_ABOUT.highlights;
const PILLAR_ICONS = [ShieldCheck, Globe2, Award];

const graph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://latammedgas.com/' },
      { '@type': 'ListItem', position: 2, name: 'Nosotros', item: 'https://latammedgas.com/nosotros/' },
    ],
  },
  { '@type': 'AboutPage', name: 'Nosotros — Latam Med Gas USA LLC', url: 'https://latammedgas.com/nosotros/' },
];
---

<Layout title={seo.title} description={seo.description} settings={settings} graph={graph}>
  <Header settings={settings} />
  <main id="contenido">
    <PageHero
      eyebrow={page?.heroEyebrow ?? seed.heroEyebrow}
      title={heading}
      subtitle={page?.heroSubtitle ?? seed.heroSubtitle}
    />

    <section class="bg-white">
      <div class="mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div class="relative order-2 lg:order-1" data-reveal>
            <div class="rotate-[2deg] rounded-2xl bg-white p-3 shadow-xl ring-1 shadow-slate-200/70 ring-slate-100">
              <SanityImage
                image={about?.image}
                alt="Pasillo hospitalario con red de gases medicinales instalada"
                caption="Latam Med Gas"
                aspect="aspect-4/3"
                class="rounded-xl"
                fallback={aboutCorridor}
              />
            </div>
            <div class="bg-accent-700 absolute -bottom-5 -left-4 hidden -rotate-3 items-center gap-2 rounded-xl px-4 py-3 shadow-lg sm:flex">
              <BadgeCheck size={18} color="#ffffff" strokeWidth={2} aria-hidden="true" />
              <span class="font-display text-xs font-bold text-white" translate="no">
                ASSE&nbsp;6000 · NFPA&nbsp;99
              </span>
            </div>
          </div>

          <div class="order-1 lg:order-2" data-reveal>
            <div class="text-accent mb-3 text-xs font-semibold tracking-[0.08em] uppercase">Quiénes somos</div>
            <p class="text-lg leading-relaxed text-slate-700">{body}</p>
            <ul class="mt-8 divide-y divide-slate-200 border-t border-slate-200">
              {highlights.map((h, i) => {
                const Icon = PILLAR_ICONS[i % PILLAR_ICONS.length];
                const accent = accentFor(i);
                return (
                  <li class="flex items-start gap-3.5 py-4">
                    <div
                      class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg"
                      style={{ backgroundColor: `${accent}1a` }}
                      aria-hidden="true"
                    >
                      <Icon size={18} color={accent} strokeWidth={2} aria-hidden="true" />
                    </div>
                    <p class="min-w-0 text-sm leading-relaxed text-slate-600">{h}</p>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
        <h2
          class="font-display text-ink mb-10 text-2xl font-extrabold tracking-tight text-balance md:text-3xl"
          data-reveal
        >
          {misionVisionHeading}
        </h2>
        <MissionVision mission={about?.mission} vision={about?.vision} />
      </div>
    </section>

    {/* El mismo componente que la portada. Esta página tenía su propia copia del marcado, que
        se había quedado en `lg:grid-cols-3`: la misma lista de cuatro salía a cuatro columnas
        en la portada y a tres más una huérfana aquí. */}
    <Certifications
      certifications={certifications}
      heading={certificacionesHeading}
      class="border-t border-slate-200 bg-white"
    />

    <PageBlocks blocks={page?.blocks} />
    <Slogan settings={settings} />
    <ContactCta settings={settings} />
  </main>
  <Footer settings={settings} />
</Layout>
