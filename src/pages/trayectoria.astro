---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NavyTexture from '../components/NavyTexture.astro';
import StatStrip from '../components/StatStrip.astro';
import ContactCta from '../components/ContactCta.astro';
import PageBlocks from '../components/PageBlocks.astro';
import Testimonials from '../components/Testimonials.astro';
import { getSiteSettings, getProjects, getTestimonials, getPage, sectionOf } from '../lib/sanityQueries';
import { DEFAULT_PROJECTS, DEFAULT_PAGES, pageSeo } from '../lib/content';
import { accentFor } from '../lib/icons';

let settings = null;
let projects: Awaited<ReturnType<typeof getProjects>> = [];
let testimonials: Awaited<ReturnType<typeof getTestimonials>> = [];
let page: Awaited<ReturnType<typeof getPage>> = null;
try {
  [settings, projects, testimonials, page] = await Promise.all([
    getSiteSettings(),
    getProjects(),
    getTestimonials(),
    getPage('trayectoria'),
  ]);
} catch (err) {
  console.warn('[Sanity] falling back to seed content:', err);
}
const items = projects.length > 0 ? projects : DEFAULT_PROJECTS;

const seed = DEFAULT_PAGES.trayectoria;
const seo = pageSeo('trayectoria', page);
const listaHeading = sectionOf(page, 'proyectosLista').heading ?? seed.sections?.proyectosLista?.heading;
const testimoniosHeading = sectionOf(page, 'testimonios').heading ?? seed.sections?.testimonios?.heading;

const graph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://latammedgas.com/' },
      { '@type': 'ListItem', position: 2, name: 'Trayectoria', item: 'https://latammedgas.com/trayectoria/' },
    ],
  },
];
---

<Layout title={seo.title} description={seo.description} settings={settings} graph={graph}>
  <Header settings={settings} />
  <main id="contenido">
    <section
      class="from-accent-700 via-accent to-accent-400 seam-cut-bottom relative overflow-hidden bg-gradient-to-br"
    >
      <NavyTexture glow="#0d948833" />
      <div class="relative mx-auto w-full max-w-7xl px-5 pt-14 pb-24 md:px-9 md:pt-20 md:pb-28">
        <span
          class="text-2xs mb-5 inline-flex items-center rounded-full bg-white/10 px-3 py-1 font-mono font-semibold text-white ring-1 ring-white/25 ring-inset"
        >
          {page?.heroEyebrow ?? seed.heroEyebrow}
        </span>
        <h1
          class="font-display max-w-3xl text-3xl leading-[1.1] font-extrabold tracking-tight text-balance text-white md:text-4xl"
        >
          {page?.heroTitle ?? seed.heroTitle}
        </h1>
        <p class="mt-5 max-w-[60ch] text-base leading-relaxed text-white/75 md:text-lg">
          {page?.heroSubtitle ?? seed.heroSubtitle}
        </p>
        <StatStrip class="mt-12" stats={settings?.stats} />
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto w-full max-w-3xl px-5 py-20 md:px-9 md:py-24">
        <h2
          class="font-display text-ink mb-12 text-2xl font-extrabold tracking-tight text-balance md:text-3xl"
          data-reveal
        >
          {listaHeading}
        </h2>

        <ol class="relative ml-1.5 border-l border-slate-200">
          {
            items.map((p, i) => (
              <li data-reveal class="relative pb-10 pl-8 last:pb-0">
                <span
                  class="absolute top-1.5 -left-[7px] h-3 w-3 rounded-full ring-4 ring-white"
                  style={{ backgroundColor: accentFor(i) }}
                  aria-hidden="true"
                />
                <div class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                  {p.date && <span class="text-2xs font-semibold tracking-wide text-slate-500">{p.date}</span>}
                  {p.serviceType && (
                    <span class="text-accent-700 bg-accent-50 text-2xs rounded-full px-2.5 py-0.5 font-semibold">
                      {p.serviceType}
                    </span>
                  )}
                </div>
                <h3 class="font-display text-ink text-lg font-bold text-balance">{p.clientName}</h3>
                {(p.location || p.country) && (
                  <p class="text-2xs mt-0.5 mb-2 font-medium text-slate-500">
                    {[p.location, p.country].filter(Boolean).join(', ')}
                  </p>
                )}
                {p.description && <p class="text-sm leading-relaxed text-slate-600">{p.description}</p>}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <Testimonials testimonials={testimonials} heading={testimoniosHeading} />
    <PageBlocks blocks={page?.blocks} />
    <ContactCta settings={settings} />
    <Footer settings={settings} />
  </main>
</Layout>
