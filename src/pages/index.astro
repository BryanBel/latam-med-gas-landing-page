---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutUs from '../components/AboutUs.astro';
import Services from '../components/Services.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';
import {
  getSiteSettings,
  getHeroSection,
  getAboutSection,
  getServices,
  getCertifications,
  getProjects,
} from '../lib/sanityQueries';
import { DEFAULT_SITE_SETTINGS } from '../lib/content';

let settings = null;
let hero = null;
let about = null;
let services: Awaited<ReturnType<typeof getServices>> = [];
let certifications: Awaited<ReturnType<typeof getCertifications>> = [];
let projects: Awaited<ReturnType<typeof getProjects>> = [];

try {
  [settings, hero, about, services, certifications, projects] = await Promise.all([
    getSiteSettings(),
    getHeroSection(),
    getAboutSection(),
    getServices(),
    getCertifications(),
    getProjects(),
  ]);
} catch (err) {
  // Page still renders with seed content from lib/content.ts, but surface the failure in build logs.
  console.warn('[Sanity] falling back to seed content:', err);
}
---

<Layout
  title={`${settings?.siteName ?? DEFAULT_SITE_SETTINGS.siteName} - Gases Medicinales ASSE 6000 / NFPA 99`}
  description={settings?.metaDescription ?? settings?.tagline ?? DEFAULT_SITE_SETTINGS.tagline}
  titleTemplate={false}
  settings={settings}
>
  <Header settings={settings} />
  {
    /* Lean summary: hero + teasers that route to their own pages. Not `.screens` (full-screen) —
     the teasers are natural height so the home reads as a concise overview. */
  }
  <main id="contenido">
    <Hero hero={hero} />
    <AboutUs about={about} />
    <Services services={services} limit={6} moreHref="/servicios" />
    <Certifications certifications={certifications} />
    <Projects projects={projects} limit={4} moreHref="/trayectoria" />
    <ContactCta tone="light" />
    <Footer settings={settings} />
  </main>
</Layout>
