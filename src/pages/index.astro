---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutUs from '../components/AboutUs.astro';
import Services from '../components/Services.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import ContactCta from '../components/ContactCta.astro';
import Slogan from '../components/Slogan.astro';
import PageBlocks from '../components/PageBlocks.astro';
import Footer from '../components/Footer.astro';
import NavyTexture from '../components/NavyTexture.astro';
import {
  getSiteSettings,
  getHeroSection,
  getAboutSection,
  getServices,
  getCertifications,
  getProjects,
  getPage,
  sectionOf,
} from '../lib/sanityQueries';
import { DEFAULT_PAGES, pageSeo } from '../lib/content';

let settings = null;
let hero = null;
let about = null;
let page: Awaited<ReturnType<typeof getPage>> = null;
let services: Awaited<ReturnType<typeof getServices>> = [];
let certifications: Awaited<ReturnType<typeof getCertifications>> = [];
let projects: Awaited<ReturnType<typeof getProjects>> = [];

try {
  [settings, hero, about, services, certifications, projects, page] = await Promise.all([
    getSiteSettings(),
    getHeroSection(),
    getAboutSection(),
    getServices(),
    getCertifications(),
    getProjects(),
    getPage('inicio'),
  ]);
} catch (err) {
  // Page still renders with seed content from lib/content.ts, but surface the failure in build logs.
  console.warn('[Sanity] falling back to seed content:', err);
}

const seed = DEFAULT_PAGES.inicio;
const seedSection = (key: keyof NonNullable<typeof seed.sections>) => seed.sections?.[key] ?? {};
const serviciosHeader = sectionOf(page, 'servicios');
const proyectosHeader = sectionOf(page, 'proyectos');
const certificacionesHeader = sectionOf(page, 'certificaciones');
const seo = pageSeo('inicio', page);
---

<Layout
  title={seo.title}
  description={page?.metaDescription ?? settings?.metaDescription ?? seo.description}
  titleTemplate={false}
  settings={settings}
>
  <Header settings={settings} />
  {/* Lean summary: hero + teasers that route to their own pages. Not `.screens` (full-screen) —
     the teasers are natural height so the home reads as a concise overview. */}
  <main id="contenido">
    <Hero hero={hero} />
    <AboutUs about={about} />
    <Services
      services={services}
      moreHref="/servicios/"
      heading={serviciosHeader.heading ?? seedSection('servicios').heading}
      subheading={serviciosHeader.subheading ?? seedSection('servicios').subheading}
      ctaLabel={serviciosHeader.ctaLabel ?? seedSection('servicios').ctaLabel}
    />
    <Certifications
      certifications={certifications}
      heading={certificacionesHeader.heading ?? seedSection('certificaciones').heading}
    />
    {/* Trayectoria, el eslogan y la banda de contacto comparten un solo fondo. Por separado
      cada una pintaba su propio degradado y su propia trama, y aunque los tonos encadenaran, el
      ojo leía tres superficies azules pegadas con la costura a la vista. Aquí el degradado y la
      trama se pintan una vez para el tramo entero y las tres van sin fondo (`bare`), así que el
      cierre de la página es una sola pieza. */}
    <div class="from-accent-700 via-accent to-accent-400 seam-cut-top relative overflow-hidden bg-gradient-to-br">
      <NavyTexture glow="#0d948833" glowClass="-top-20 -right-20 h-[380px] w-[380px]" />
      {/* Segundo resplandor abajo: el tramo es alto y uno solo arriba dejaba apagado el final,
        justo donde está el botón. */}
      <div
        class="glow-drift pointer-events-none absolute -bottom-28 -left-24 h-[420px] w-[420px] rounded-full blur-3xl"
        aria-hidden="true"
        style={{ backgroundColor: '#7c3aed2e' }}
      ></div>
      <Projects
        projects={projects}
        limit={4}
        moreHref="/trayectoria/"
        stats={settings?.stats}
        heading={proyectosHeader.heading ?? seedSection('proyectos').heading}
        subheading={proyectosHeader.subheading ?? seedSection('proyectos').subheading}
        ctaLabel={proyectosHeader.ctaLabel ?? seedSection('proyectos').ctaLabel}
        bare
      />
      <Slogan settings={settings} onNavy />
      <ContactCta settings={settings} bare />
    </div>
    <PageBlocks blocks={page?.blocks} />
  </main>
  <Footer settings={settings} />
</Layout>
