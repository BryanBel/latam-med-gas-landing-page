---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutUs from '../components/AboutUs.astro';
import Services from '../components/Services.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import {
  getSiteSettings,
  getHeroSection,
  getAboutSection,
  getServices,
  getCertifications,
  getProjects,
} from '../lib/sanityQueries';
import { DEFAULT_SITE_SETTINGS } from '../lib/content';

let settings = null;
let hero = null;
let about = null;
let services: Awaited<ReturnType<typeof getServices>> = [];
let certifications: Awaited<ReturnType<typeof getCertifications>> = [];
let projects: Awaited<ReturnType<typeof getProjects>> = [];

try {
  [settings, hero, about, services, certifications, projects] = await Promise.all([
    getSiteSettings(),
    getHeroSection(),
    getAboutSection(),
    getServices(),
    getCertifications(),
    getProjects(),
  ]);
} catch (err) {
  // Page still renders with seed content from lib/content.ts, but surface the failure in build logs.
  console.warn('[Sanity] falling back to seed content:', err);
}
---

<Layout
  title={`${settings?.siteName ?? DEFAULT_SITE_SETTINGS.siteName} - Gases Medicinales ASSE 6000 / NFPA 99`}
  description={settings?.tagline ?? DEFAULT_SITE_SETTINGS.tagline}
>
  <Header settings={settings} />
  <main id="contenido">
    <Hero hero={hero} />
    <AboutUs about={about} />
    <Services services={services} />
    <Certifications certifications={certifications} />
    <Projects projects={projects} />
    <div class="contact-screen">
      <ContactSection settings={settings} />
      <Footer settings={settings} />
    </div>
  </main>
</Layout>
