---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm';
import PageBlocks from '../components/PageBlocks.astro';
import { getSiteSettings, getPage } from '../lib/sanityQueries';
import { DEFAULT_SITE_SETTINGS, DEFAULT_PAGES, pageSeo } from '../lib/content';
import { accentFor } from '../lib/icons';
import { Phone, Mail, MapPin, ExternalLink } from 'lucide-react';

let settings = null;
let page: Awaited<ReturnType<typeof getPage>> = null;
try {
  [settings, page] = await Promise.all([getSiteSettings(), getPage('contacto')]);
} catch (err) {
  console.warn('[Sanity] falling back to seed content:', err);
}
const seed = DEFAULT_PAGES.contacto;
const seo = pageSeo('contacto', page);

const phone = settings?.phone ?? DEFAULT_SITE_SETTINGS.phone;
const email = settings?.email ?? DEFAULT_SITE_SETTINGS.email;
const address = settings?.address ?? DEFAULT_SITE_SETTINGS.address;

// The client gave two numbers in one field; split so each is its own tappable tel: link.
const phoneLinks = phone
  .split('/')
  .map((p) => p.trim())
  .filter(Boolean)
  .map((p) => ({ href: `tel:${p.replace(/[^+\d]/g, '')}`, text: p }));

const CONTACT_ROWS = [
  { label: 'Teléfono', Icon: Phone, links: phoneLinks, text: '' },
  { label: 'Correo', Icon: Mail, links: [{ href: `mailto:${email}`, text: email }], text: '' },
  { label: 'Dirección', Icon: MapPin, links: [], text: address },
];
const contactLinkClass =
  'hover:text-accent focus-visible:ring-accent rounded-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';

// El mapa incrustado es OpenStreetMap, no Google. El embed de OSM no manda ni una cabecera
// Set-Cookie —comprobado—, así que la Política de Privacidad puede seguir diciendo que el sitio
// no usa cookies de seguimiento, que es lo que ahorra el banner de consentimiento. El iframe de
// Google habría costado las dos cosas: reescribir esa frase y, para visitantes europeos, poner
// banner.
//
// Las coordenadas son las de One Biscayne Tower, resueltas desde la dirección postal con
// Nominatim, el geocodificador del propio OSM. El recuadro son unos 600 m de lado: suficiente
// para situar la manzana sin que el edificio se pierda.
const MAPA_LAT = 25.77382;
const MAPA_LON = -80.18798;
const mapaEmbed =
  'https://www.openstreetmap.org/export/embed.html' +
  '?bbox=-80.1910%2C25.7723%2C-80.1850%2C25.7753&layer=mapnik' +
  `&marker=${MAPA_LAT}%2C${MAPA_LON}`;

// El botón sigue llevando a Google Maps: es con lo que la gente navega de verdad, y como es un
// enlace y no un iframe, nada de Google se carga hasta que el visitante decide ir.
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

const graph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://latammedgas.com/' },
      { '@type': 'ListItem', position: 2, name: 'Contacto', item: 'https://latammedgas.com/contacto/' },
    ],
  },
  { '@type': 'ContactPage', name: 'Contacto — Latam Med Gas USA LLC', url: 'https://latammedgas.com/contacto/' },
];
---

<Layout title={seo.title} description={seo.description} settings={settings} graph={graph}>
  <Header settings={settings} />
  <main id="contenido">
    <PageHero
      eyebrow={page?.heroEyebrow ?? seed.heroEyebrow}
      title={page?.heroTitle ?? seed.heroTitle ?? seo.title}
      subtitle={page?.heroSubtitle ?? seed.heroSubtitle}
      glow="#2563eb33"
    />

    <section class="bg-white">
      <div class="mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
        {/* Columnas con mínimo 0. Sin `grid-cols-1`, en móvil la única columna es implícita
            (`auto`) y se ensancha hasta el contenido más ancho: la caja de Turnstile mide 302 px
            aunque esté invisible, y con el relleno de la tarjeta empujaba la página 3 px más allá
            de la pantalla a 375 px, con scroll horizontal incluido. */}
        <div class="grid grid-cols-1 gap-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div data-reveal>
            <dl class="space-y-5">
              {CONTACT_ROWS.map(({ label, Icon, links, text }, i) => {
                const accent = accentFor(i);
                return (
                  /* Grid rather than nested flex: dt and dd have to be direct children of a
                       div that is itself a direct child of the dl, or screen readers lose the
                       pairing. The icon spans both rows to keep the same layout. */
                  <div class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-3.5">
                    <span
                      class="row-span-2 mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                      style={{ backgroundColor: `${accent}1a` }}
                      aria-hidden="true"
                    >
                      <Icon size={18} color={accent} strokeWidth={2} aria-hidden="true" />
                    </span>
                    <dt class="text-2xs mb-0.5 font-semibold tracking-[0.08em] text-slate-500 uppercase">{label}</dt>
                    <dd class="text-ink text-sm leading-relaxed font-medium break-words">
                      {links.length > 0 ? (
                        <span class="flex flex-col gap-0.5">
                          {links.map((l) => (
                            <a href={l.href} class={contactLinkClass}>
                              {l.text}
                            </a>
                          ))}
                        </span>
                      ) : (
                        text
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>

            {/* Ubicación. El mapa es de verdad y navegable; ver el porqué de OSM arriba. */}
            <div class="mt-8 overflow-hidden rounded-2xl ring-1 ring-slate-200" data-reveal>
              <iframe
                src={mapaEmbed}
                title="Mapa de la ubicación de Latam Med Gas USA LLC en Miami, Florida"
                class="block h-56 w-full border-0 sm:h-64"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
              <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm leading-relaxed text-slate-600">{address}</p>
                <a
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="press-feedback bg-accent hover:bg-accent-600 focus-visible:ring-accent inline-flex shrink-0 items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
                >
                  Abrir en Google Maps
                  <ExternalLink size={15} strokeWidth={2.5} aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>

          <div class="rounded-2xl bg-white p-7 ring-1 ring-slate-200 md:p-9" data-reveal>
            <ContactForm client:visible />
          </div>
        </div>
      </div>
    </section>

    <PageBlocks blocks={page?.blocks} />
  </main>
  <Footer settings={settings} />
</Layout>
