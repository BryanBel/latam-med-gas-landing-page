---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings, getPage } from '../lib/sanityQueries';
import { DEFAULT_SITE_SETTINGS, DEFAULT_PAGES, pageSeo } from '../lib/content';

// Plain <div> rather than <section>: the `main > section` rule in global.css forces a
// full-screen minimum, which is wrong for a long text page.
let settings = null;
let page: Awaited<ReturnType<typeof getPage>> = null;
try {
  [settings, page] = await Promise.all([getSiteSettings(), getPage('privacidad')]);
} catch (err) {
  console.warn('[Sanity] falling back to seed content:', err);
}
const seed = DEFAULT_PAGES.privacidad;
const seo = pageSeo('privacidad', page);
const sections = page?.contentSections?.length ? page.contentSections : (seed.contentSections ?? []);
const email = settings?.email ?? DEFAULT_SITE_SETTINGS.email;
const address = settings?.address ?? DEFAULT_SITE_SETTINGS.address;
---

<Layout title={seo.title} description={seo.description} settings={settings}>
  <Header settings={settings} />
  <main id="contenido">
    <div class="mx-auto max-w-3xl px-5 py-16 md:px-9 md:py-20">
      <div class="text-accent mb-3 text-xs font-semibold tracking-[0.08em] uppercase">Legal</div>
      <h1 class="font-display text-ink text-2xl font-extrabold tracking-tight text-balance md:text-3xl">
        {page?.heroTitle ?? seed.heroTitle}
      </h1>

      {
        /* Sin aviso de borrador. Estuvo en vivo desde el lanzamiento diciendo que el sitio aún
          no había lanzado, que es lo peor de los dos mundos: restaba confianza al visitante y
          no acercaba la revisión legal. El texto describe con exactitud lo que hace el sitio,
          así que como política es válida; que un abogado de la empresa la revise sigue
          pendiente y está anotado en las dudas del cliente, no en la cara del visitante. */
      }

      {
        sections.map(({ heading, body }) => (
          <section class="mt-10">
            <h2 class="font-display text-ink mb-3 text-xl font-bold">{heading}</h2>
            <p class="text-base leading-relaxed text-slate-600">{body}</p>
          </section>
        ))
      }

      <section class="mt-10">
        <h2 class="font-display text-ink mb-3 text-xl font-bold">Contacto</h2>
        <p class="text-base leading-relaxed text-slate-600">
          Para cualquier consulta sobre esta política, escríbanos a{' '}
          <a
            href={`mailto:${email}`}
            class="text-accent hover:text-accent-600 focus-visible:ring-accent rounded-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
          >
            {email}
          </a>
          . Nuestra dirección es {address}.
        </p>
      </section>

      <p class="mt-12 text-xs text-slate-500">Última actualización: 23 de septiembre de 2026.</p>
    </div>
  </main>
  <Footer settings={settings} />
</Layout>
