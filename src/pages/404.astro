---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NavyTexture from '../components/NavyTexture.astro';

// No Sanity query here on purpose: an error page should render even when the CMS is
// unreachable, and Header/Footer fall back to the seed settings and the local mark.
---

<Layout title="Página no encontrada" description="La página que busca no existe o fue movida.">
  <Header settings={null} />
  <main id="contenido">
    {
      /* Reuses the Contacto screen wrapper so the message and the footer share one viewport
        instead of the footer sitting below the fold on an otherwise empty page. */
    }
    <div class="contact-screen">
      <section
        class="from-accent-700 via-accent to-accent-400 seam-cut-bottom relative overflow-hidden bg-gradient-to-br"
      >
        <NavyTexture glow="#2563eb33" glowClass="-top-24 -right-24 h-[420px] w-[420px]" />

        <div class="relative mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
          <div class="max-w-2xl">
            <div class="text-accent-100 mb-3 font-mono text-xs font-semibold tracking-[0.08em] uppercase">
              Error 404
            </div>
            <h1
              class="font-display text-3xl leading-[1.1] font-extrabold tracking-tight text-balance text-white md:text-4xl"
            >
              Esta página no existe
            </h1>
            <p class="mt-6 max-w-[52ch] text-base leading-relaxed text-white/75 md:text-lg">
              Puede que el enlace esté roto o que la página se haya movido. Vuelva al inicio para seguir navegando.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a
                href="/"
                class="press-feedback focus-visible:ring-accent-200 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-[var(--color-accent-700)] shadow-lg shadow-black/20 transition-transform focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-accent)] focus-visible:outline-none motion-safe:hover:-translate-y-0.5"
              >
                Volver al inicio
              </a>
              <a
                href="/contacto/"
                class="focus-visible:ring-accent-200 rounded-full border border-white/40 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-accent)] focus-visible:outline-none"
              >
                Contáctenos
              </a>
            </div>
          </div>
        </div>
      </section>

      <Footer settings={null} />
    </div>
  </main>
</Layout>
