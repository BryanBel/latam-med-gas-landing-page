---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import CertifyingBodies from '../components/CertifyingBodies.astro';
import Slogan from '../components/Slogan.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { getSiteSettings, getCourses, getPage, sectionOf } from '../lib/sanityQueries';
import { DEFAULT_COURSES, DEFAULT_PAGES, pageSeo } from '../lib/content';
import { Image } from 'astro:assets';
import cursoFoto from '../assets/photos/curso-asse-6000.jpg';
import { accentFor } from '../lib/icons';

let settings = null;
let courses: Awaited<ReturnType<typeof getCourses>> = [];
let page: Awaited<ReturnType<typeof getPage>> = null;
try {
  [settings, courses, page] = await Promise.all([getSiteSettings(), getCourses(), getPage('cursos')]);
} catch (err) {
  console.warn('[Sanity] falling back to seed content:', err);
}
const items = courses.length > 0 ? courses : DEFAULT_COURSES;

const seed = DEFAULT_PAGES.cursos;
const seo = pageSeo('cursos', page);
// El bloque junto a la foto reparte en dos campos lo que antes vivía apretado en `heading`: se
// pintaba como un párrafo suelto de 16px en gris claro al lado de una foto a media página, sin
// nada que lo anclara.
//
// Sin botón. Lo tuvo un rato y sobraba: «Contáctenos» ya está en el menú superior y la banda de
// cierre lo repite al final de cada página, así que un tercer enlace al mismo sitio en mitad
// del recorrido es ruido, no ayuda.
const notaSec = sectionOf(page, 'cursosNota');
const notaSeed = seed.sections?.cursosNota ?? {};
const notaTitulo = notaSec.heading ?? notaSeed.heading;
const notaTexto = notaSec.subheading ?? notaSeed.subheading;
const banda = sectionOf(page, 'bandaContacto');
const bandaSeed = seed.sections?.bandaContacto ?? {};

const graph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://latammedgas.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cursos ASSE 6000', item: 'https://latammedgas.com/cursos/' },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'Cursos de capacitación ASSE serie 6000',
    itemListElement: items.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `ASSE ${c.code} — ${c.title} en sistemas de gases medicinales`,
    })),
  },
];
---

<Layout title={seo.title} description={seo.description} settings={settings} graph={graph}>
  <Header settings={settings} />
  <main id="contenido">
    <PageHero
      eyebrow={page?.heroEyebrow ?? seed.heroEyebrow}
      title={page?.heroTitle ?? seed.heroTitle ?? seo.title}
      subtitle={page?.heroSubtitle ?? seed.heroSubtitle}
      glow="#2563eb33"
    />

    <section class="bg-white">
      <div class="mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            items.map((c, i) => (
              <div
                data-reveal
                data-tilt
                data-reveal-delay={(i % 3) * 60}
                class="hover:ring-accent-200 rounded-2xl bg-white p-6 ring-1 ring-slate-200 transition-[transform,box-shadow] hover:shadow-lg hover:shadow-slate-200/60 motion-safe:hover:-translate-y-0.5"
              >
                <div class="mb-3 flex items-center gap-3">
                  <span
                    class="font-display text-2xs shrink-0 rounded-full px-2.5 py-1 font-bold text-white"
                    style={{ backgroundColor: accentFor(i) }}
                    translate="no"
                  >
                    ASSE {c.code}
                  </span>
                  <h2 class="font-display text-ink min-w-0 text-base font-bold text-balance">{c.title}</h2>
                </div>
                <p class="text-xs leading-relaxed text-slate-600">{c.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      /* La foto es de un curso real de LMG. Es vertical y el techo del salón se lleva el tercio
      superior, así que se recorta a 4/5 y se encuadra algo por debajo del centro para que la
      mesa y los asistentes queden en el eje. */
    }
    <section class="bg-white">
      <div class="mx-auto w-full max-w-7xl px-5 pb-20 md:px-9 md:pb-24">
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
          <div data-reveal>
            <Image
              src={cursoFoto}
              alt="José Sepúlveda impartiendo un curso de gases medicinales de Latam Med Gas"
              widths={[480, 800, 900]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              format="webp"
              class="aspect-4/5 w-full rounded-2xl object-cover shadow-xl shadow-slate-200/70 sm:aspect-4/3 lg:aspect-4/5"
              style={{ objectPosition: 'center 62%' }}
            />
          </div>
          <div data-reveal>
            <h2 class="font-display text-ink text-2xl font-extrabold tracking-tight text-balance md:text-3xl">
              {notaTitulo}
            </h2>
            {notaTexto && <p class="mt-4 max-w-[52ch] text-base leading-relaxed text-slate-600">{notaTexto}</p>}

            {
              /* Quién da la clase de la foto. Va codificado aquí y no en el Studio a propósito:
                es el crédito de *esta* fotografía, que vive en el repositorio como ella, y deja
                de ser cierto en cuanto se cambie la imagen. Un campo editable suelto en Sanity
                se quedaría con el nombre viejo bajo una foto nueva.

                «Instructor», no «instructor certificado ASSE 6050»: esa credencial sigue sin
                verificarse y es exactamente la frase que se retiró de esta página en agosto.
                Si se confirma, aquí es donde vuelve. */
            }
            <div class="mt-8 border-t border-slate-200 pt-5">
              <p class="font-display text-ink text-sm font-bold">José Sepúlveda</p>
              <p class="text-2xs mt-0.5 font-medium text-slate-500">Propietario e instructor</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <PageBlocks blocks={page?.blocks} />
    <CertifyingBodies />
    <Slogan settings={settings} />
    <ContactCta
      settings={settings}
      title={banda.heading ?? bandaSeed.heading}
      text={banda.subheading ?? bandaSeed.subheading}
    />
  </main>
  <Footer settings={settings} />
</Layout>
