---
import NavyTexture from './NavyTexture.astro';
import type { Service } from '../lib/sanityQueries';
import { DEFAULT_SERVICES } from '../lib/content';
import { resolveServiceIcon, accentFor } from '../lib/icons';
import { ArrowRight } from 'lucide-react';

interface Props {
  services: Service[];
  moreHref?: string;
  limit?: number;
}

const { services, moreHref, limit } = Astro.props;
const source = services.length > 0 ? services : DEFAULT_SERVICES;
const items = limit ? source.slice(0, limit) : source;
---

{
  /* Gradient runs the opposite way to Inicio's: light at the top left into navy at the
    bottom right, so the scroll reads navy→light, light→navy, navy→light. */
}
<section
  id="servicios"
  class="from-accent-400 via-accent to-accent-700 seam-cut-both relative overflow-hidden bg-gradient-to-br"
>
  <NavyTexture glow="#b4530933" glowClass="-bottom-24 -left-24 h-[420px] w-[420px]" />

  <div class="relative mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
    <div class="mb-12 max-w-2xl" data-reveal>
      {
        /* accent-100 rather than Proyectos' accent-200: the inverted gradient puts its lightest
          blue right here, and accent-200 only reached 4.07:1 against it. */
      }
      <div class="text-accent-100 mb-3 text-xs font-semibold tracking-[0.08em] uppercase">Servicios</div>
      <h2 class="font-display text-2xl font-extrabold tracking-tight text-balance text-white md:text-3xl">
        Todo lo que su institución necesita en gases medicinales
      </h2>
      <p class="mt-3 text-base text-white/75">
        Desde el diseño hasta la verificación final, cubrimos cada etapa bajo normativa ASSE y NFPA.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((s, i) => {
          const Icon = resolveServiceIcon(s.icon);
          const accent = accentFor(i);
          // A service with a page of its own becomes a link. Everything else stays a plain card,
          // so the affordance below is what tells the two apart.
          const Tag = s.link ? 'a' : 'div';
          return (
            <Tag
              href={s.link}
              data-reveal
              data-tilt
              data-reveal-delay={(i % 4) * 70}
              class:list={[
                'group hover:ring-accent-200 rounded-2xl bg-white p-6 ring-1 ring-slate-200 transition-[transform,box-shadow] hover:shadow-lg hover:shadow-slate-200/60 motion-safe:hover:-translate-y-0.5',
                s.link &&
                  'focus-visible:ring-accent flex flex-col focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none',
              ]}
            >
              <div class="mb-3 flex items-center gap-3">
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition-transform motion-safe:group-hover:scale-105"
                  style={{ backgroundColor: `${accent}1a` }}
                  aria-hidden="true"
                >
                  <Icon size={20} color={accent} strokeWidth={2} aria-hidden="true" />
                </div>
                <h3 class="font-display text-ink min-w-0 text-base font-bold text-balance">{s.title}</h3>
              </div>
              <p class="text-xs leading-relaxed text-slate-600">{s.description}</p>
              {s.link && (
                <span class="text-accent mt-3 inline-flex items-center gap-1.5 text-xs font-semibold [&_svg]:transition-transform [&_svg]:duration-200 group-hover:[&_svg]:translate-x-0.5 motion-reduce:[&_svg]:transform-none">
                  Ver más
                  <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" />
                </span>
              )}
            </Tag>
          );
        })
      }
    </div>

    {
      moreHref && (
        <div class="mt-10" data-reveal>
          <a
            href={moreHref}
            class="press-feedback focus-visible:ring-accent-200 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-[var(--color-accent-700)] shadow-lg shadow-black/20 transition-transform focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-accent)] focus-visible:outline-none motion-safe:hover:-translate-y-0.5 [&_svg]:transition-transform [&_svg]:duration-200 hover:[&_svg]:translate-x-1 motion-reduce:[&_svg]:transform-none"
          >
            Ver todos los servicios
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>
        </div>
      )
    }
  </div>
</section>
