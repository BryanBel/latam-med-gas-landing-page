---
// Half of the diagonal that cuts across a section seam. The two halves belong to different
// sections: the upper one draws the right half in its neighbour's colour, the lower one
// draws the left half in the upper section's colour, and together they read as one line
// running from the lower left up to the right — the same slope everywhere on the page.

interface Props {
  // 'bottom' draws the right half at the foot of a section, 'top' the left half at its head.
  edge: 'top' | 'bottom';
  // Background class for the wedge: bg-white against a light neighbour, or the accent step
  // that matches the navy section's gradient where it meets this seam.
  fill: string;
  // Carries Inicio's dot field over the wedge, so a navy half keeps the texture instead of
  // showing as a flat block of blue.
  textured?: boolean;
}

const { edge, fill, textured = false } = Astro.props;

const clipPath = edge === 'bottom' ? 'polygon(50% 100%, 100% 0, 100% 100%)' : 'polygon(0 0, 50% 0, 0 100%)';
---

<div
  class:list={[
    'pointer-events-none absolute left-0 h-[35px] w-full',
    fill,
    edge === 'bottom' ? '-bottom-px' : '-top-px',
  ]}
  aria-hidden="true"
  style={{ clipPath }}
>
  {
    textured && (
      <div
        class="absolute inset-0 opacity-[0.12]"
        style={{
          backgroundImage: 'radial-gradient(circle, #ffffff 1.4px, transparent 1.4px)',
          backgroundSize: '26px 26px',
        }}
      />
    )
  }
</div>
