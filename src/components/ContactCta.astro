---
// Closing call-to-action band. Links to the /contacto page. Navy by default; `tone="light"`
// exists for a page where the section above it is already navy.
import { ArrowRight } from 'lucide-react';
import NavyTexture from './NavyTexture.astro';
import type { SiteSettings } from '../lib/sanityQueries';
import { DEFAULT_SITE_SETTINGS } from '../lib/content';

interface Props {
  settings?: SiteSettings | null;
  title?: string;
  text?: string;
  tone?: 'navy' | 'light';
  // Sin fondo propio: hereda el del tramo azul que la envuelve.
  bare?: boolean;
}
const { settings, tone = 'navy', bare = false } = Astro.props;
const title = Astro.props.title ?? settings?.ctaTitle ?? DEFAULT_SITE_SETTINGS.ctaTitle;
const text = Astro.props.text ?? settings?.ctaText ?? DEFAULT_SITE_SETTINGS.ctaText;

const light = tone === 'light';

// Both edges square, by request. The diagonal belongs to the seams between content sections;
// on the closing band it cut into the breathing room above the heading and made the page end
// on a slant instead of on the call to action.
//
// The navy tone carries the same gradient and dot field as every other navy section. It was
// the one flat one, which showed as soon as the diagonal came off and left a plain rectangle
// next to textured neighbours.
//
// No border-top on the light tone either: a full-width 1px rule read as a stray horizontal
// line right under a diagonal.
---

<section
  class:list={[
    'relative overflow-hidden',
    bare ? '' : light ? 'bg-white' : 'from-accent-700 via-accent to-accent-400 bg-gradient-to-br',
  ]}
>
  {/* El violeta WAGD no lo usa ninguna otra sección, así que la banda de cierre se distingue
    de la que tenga encima en cualquier página. El resplandor abajo a la izquierda asienta el
    final de la página en vez de tirar la mirada hacia arriba. */}
  {!light && !bare && <NavyTexture glow="#7c3aed33" glowClass="-bottom-28 -left-24 h-[420px] w-[420px]" />}
  <div class="relative mx-auto w-full max-w-7xl px-5 py-16 text-center md:px-9 md:py-20" data-reveal>
    <h2
      class:list={[
        'font-display mx-auto max-w-2xl text-2xl font-extrabold tracking-tight text-balance md:text-3xl',
        light ? 'text-ink' : 'text-white',
      ]}
    >
      {title}
    </h2>
    {text && (
      <p class:list={['mx-auto mt-4 max-w-[52ch] text-base', light ? 'text-slate-600' : 'text-white/75']}>{text}</p>
    )}
    <a
      href="/contacto/"
      class:list={[
        'press-feedback mt-8 inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold shadow-lg transition-transform focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none motion-safe:hover:-translate-y-0.5 [&_svg]:transition-transform [&_svg]:duration-200 hover:[&_svg]:translate-x-1 motion-reduce:[&_svg]:transform-none',
        light
          ? 'bg-accent focus-visible:ring-accent text-white shadow-black/10 focus-visible:ring-offset-white'
          : 'focus-visible:ring-accent-200 bg-white text-[var(--color-accent-700)] shadow-black/20 focus-visible:ring-offset-[var(--color-accent-700)]',
      ]}
    >
      Contáctenos
      <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
    </a>
  </div>
</section>
