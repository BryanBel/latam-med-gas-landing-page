---
// Compact navy hero for interior pages (/servicios, /cursos, /trayectoria). Shares the home
// hero's gradient + dot field so the pages read as one site, but at a fraction of the height.
import NavyTexture from './NavyTexture.astro';
import SectionWedge from './SectionWedge.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  glow?: string;
}
const { eyebrow, title, subtitle, glow = '#15803d33' } = Astro.props;
---

<section class="from-accent-700 via-accent to-accent-400 relative overflow-hidden bg-gradient-to-br">
  <NavyTexture glow={glow} />
  <div class="relative mx-auto w-full max-w-7xl px-5 pt-14 pb-24 md:px-9 md:pt-20 md:pb-28">
    {
      eyebrow && (
        <span class="text-2xs mb-5 inline-flex items-center rounded-full bg-white/10 px-3 py-1 font-mono font-semibold text-white ring-1 ring-white/25 ring-inset">
          {eyebrow}
        </span>
      )
    }
    <h1
      class="font-display max-w-3xl text-3xl leading-[1.1] font-extrabold tracking-tight text-balance text-white md:text-4xl"
    >
      {title}
    </h1>
    {subtitle && <p class="mt-5 max-w-[60ch] text-base leading-relaxed text-white/75 md:text-lg">{subtitle}</p>}
  </div>
  <SectionWedge edge="bottom" fill="bg-white" />
</section>
