---
interface Props {
  caption: string;
  aspect?: string;
  class?: string;
}

const { caption, aspect = 'aspect-[4/3]', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'rounded-lg bg-slate-50 ring-1 ring-inset ring-slate-200 flex flex-col items-center justify-center gap-2',
    aspect,
    className,
  ]}
>
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true" class="text-slate-300">
    <rect x="2.5" y="4.5" width="21" height="17" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
    <circle cx="9" cy="10.5" r="2" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M3.5 18l5.5-5.5a2 2 0 0 1 2.8 0L18 18.5M15.5 16l1.8-1.8a2 2 0 0 1 2.8 0l2.4 2.4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="text-[11px] font-mono uppercase tracking-[0.08em] text-slate-400 text-center px-3">{caption}</span>
</div>
