---
// Los entes que emiten la certificación, con sus logos.
//
// Es el respaldo que separa lo que hace LMG de lo que hace un tercero: aquí se capacita, y el
// certificado lo emite un organismo acreditado. Decirlo con los logos y el número de
// acreditación pesa más que repetirlo en otra frase.
//
// Los logos van sobre tarjetas blancas a propósito: los archivos vienen con fondo blanco, así
// que sobre la banda gris se verían como recuadros sueltos. En tarjeta, ese blanco es el
// soporte y no un defecto.
import { Image } from 'astro:assets';
import conecotecLogo from '../assets/logos/conecotec.png';
import emaLogo from '../assets/logos/ema.png';
import nitcLogo from '../assets/logos/nitc.png';

interface Props {
  eyebrow?: string;
  heading?: string;
}

const { eyebrow = 'Entes certificadores', heading = 'La certificación la emite un organismo acreditado' } = Astro.props;

// El archivo de NITC es el oficial de su propio sitio (nationalitc.net), no la captura con
// fondo que llegó en el envío. Son 220×105 con transparencia: alcanza para la altura a la que
// se muestra, pero es lo más chico de los tres, así que si NITC manda un vectorial conviene
// cambiarlo. La autorización de uso de marca de NITC se obtuvo el 25/09/2026.
// El pie dice el papel de cada uno, no la expansión de la sigla. Un gerente de hospital en
// Bogotá o Panamá no tiene por qué saber qué es «ema», y antes la tarjeta lo daba por sabido:
// decía «acredita a CONECOTEC» sin decir nunca quién acredita. Quién es cada uno y qué aporta
// es lo que hace que el respaldo signifique algo.
const entes = [
  {
    nombre: 'CONECOTEC',
    logo: conecotecLogo,
    pie: 'Organismo de certificación de personas, acreditado por ema',
  },
  {
    nombre: 'ema',
    logo: emaLogo,
    pie: 'Entidad Mexicana de Acreditación · acreditación 252/25',
  },
  {
    nombre: 'NITC',
    logo: nitcLogo,
    pie: 'National Inspection Testing and Certification Corporation · Estados Unidos',
  },
];
---

<section class="relative overflow-hidden bg-slate-50">
  <div class="mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
    <div class="mb-12 max-w-2xl" data-reveal>
      <div class="text-accent mb-3 text-xs font-semibold tracking-[0.08em] uppercase">{eyebrow}</div>
      <h2 class="font-display text-ink text-2xl font-extrabold tracking-tight text-balance md:text-3xl">{heading}</h2>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        Latam Med Gas imparte la capacitación. El certificado lo emiten los organismos con los que mantenemos convenio.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {entes.map((ente, i) => (
        <div
          data-reveal
          data-reveal-delay={i * 90}
          class="flex flex-col items-center rounded-xl bg-white p-8 text-center ring-1 ring-slate-200/80"
        >
          <Image
            src={ente.logo}
            alt={ente.nombre}
            widths={[240, 360]}
            sizes="(min-width: 640px) 240px, 60vw"
            format="webp"
            class="h-16 w-auto object-contain"
          />
          <p class="mt-6 text-xs leading-relaxed text-balance text-slate-500">{ente.pie}</p>
        </div>
      ))}
    </div>
  </div>
</section>
