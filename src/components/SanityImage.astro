---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { sanityImageUrl } from '../lib/sanityImage';
import type { SanityImageRef } from '../lib/sanityQueries';

interface Props {
  image?: SanityImageRef;
  alt: string;
  caption: string;
  aspect?: string;
  class?: string;
  width?: number;
  // Local seed photo shown until the client uploads a real image in Sanity — takes
  // priority over the gray placeholder, but Sanity always wins once populated. Pass the
  // imported asset itself, not its `.src`: a bare URL skips astro:assets, which is how the
  // 1.1 MB hero PNG ended up being served untouched.
  fallback?: ImageMetadata;
  // How wide the image actually renders, for the srcset. Defaults to the common case here:
  // full width on phones, half of the container from tablet up.
  sizes?: string;
  // Above-the-fold images (the hero) must load eagerly — a lazy LCP image delays paint.
  priority?: boolean;
}

const {
  image,
  alt,
  caption,
  aspect = 'aspect-[4/3]',
  class: className = '',
  width = 1200,
  fallback,
  sizes = '(min-width: 768px) 50vw, 100vw',
  priority = false,
} = Astro.props;

// Sanity serves its own derivatives; only the local seed photos need astro:assets. Widths are
// capped at the source width so sharp never upscales.
const sanitySrc = sanityImageUrl(image, width);

// Reserve layout space from the same ratio the `aspect` class enforces, so the width/height
// attributes and the CSS box can never disagree.
const parsed = aspect.match(/(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/);
const height = Math.round((width * Number(parsed?.[2] ?? 3)) / Number(parsed?.[1] ?? 4));

// Crop to the same ratio the CSS box shows. Without this the seed photos ship at their native
// portrait height and object-cover throws roughly half those pixels away on every load.
const ratio = height / width;
const optimized =
  !sanitySrc && fallback
    ? await getImage({
        src: fallback,
        widths: [480, 800, width].filter((w) => w <= fallback.width),
        format: 'webp',
        fit: 'cover',
        position: 'center',
        height: Math.round(Math.min(width, fallback.width) * ratio),
      })
    : null;

const src = sanitySrc ?? optimized?.src ?? null;
const srcset = optimized?.srcSet?.attribute || undefined;
---

{
  src ? (
    <img
      src={src}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['w-full object-cover', aspect, className]}
    />
  ) : (
    <ImagePlaceholder caption={caption} aspect={aspect} class={className} />
  )
}
