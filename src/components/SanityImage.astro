---
import ImagePlaceholder from './ImagePlaceholder.astro';
import { sanityImageUrl } from '../lib/sanityImage';
import type { SanityImageRef } from '../lib/sanityQueries';

interface Props {
  image?: SanityImageRef;
  alt: string;
  caption: string;
  aspect?: string;
  class?: string;
  width?: number;
  // Local seed photo shown until the client uploads a real image in Sanity — takes
  // priority over the gray placeholder, but Sanity always wins once populated.
  fallbackSrc?: string;
  // Above-the-fold images (the hero) must load eagerly — a lazy LCP image delays paint.
  priority?: boolean;
}

const {
  image,
  alt,
  caption,
  aspect = 'aspect-[4/3]',
  class: className = '',
  width = 1200,
  fallbackSrc,
  priority = false,
} = Astro.props;

const src = sanityImageUrl(image, width) ?? fallbackSrc ?? null;

// Reserve layout space from the same ratio the `aspect` class enforces, so the width/height
// attributes and the CSS box can never disagree.
const parsed = aspect.match(/(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/);
const height = Math.round((width * Number(parsed?.[2] ?? 3)) / Number(parsed?.[1] ?? 4));
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['w-full object-cover', aspect, className]}
    />
  ) : (
    <ImagePlaceholder caption={caption} aspect={aspect} class={className} />
  )
}
