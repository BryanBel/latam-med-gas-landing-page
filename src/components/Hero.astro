---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { HeroSection } from '../lib/sanity-queries';
import { DEFAULT_HERO } from '../lib/content';

interface Props {
  hero: HeroSection | null;
}

const { hero } = Astro.props;
const eyebrow = hero?.eyebrow ?? DEFAULT_HERO.eyebrow;
const heading = hero?.heading ?? DEFAULT_HERO.heading;
const subheading = hero?.subheading ?? DEFAULT_HERO.subheading;
const ctaLabel = hero?.ctaLabel ?? DEFAULT_HERO.ctaLabel;
const ctaLink = hero?.ctaLink ?? DEFAULT_HERO.ctaLink;
---

<section id="inicio" class="max-w-7xl mx-auto px-5 md:px-9 py-16 md:py-24 grid lg:grid-cols-2 gap-12 items-center">
  <div>
    <div class="text-[13px] font-semibold text-accent uppercase tracking-[0.08em] mb-4">{eyebrow}</div>
    <h1 class="font-display font-extrabold text-[32px] md:text-[44px] text-ink tracking-tight leading-[1.1]">
      {heading}
    </h1>
    <p class="mt-5 text-slate-600 text-[16px] md:text-[17px] leading-relaxed max-w-[52ch]">
      {subheading}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={ctaLink}
        class="px-6 py-3 rounded-lg bg-accent text-white text-[14.5px] font-semibold hover:bg-accent-600 transition-colors"
      >
        {ctaLabel}
      </a>
      <a
        href="#servicios"
        class="px-6 py-3 rounded-lg ring-1 ring-slate-200 text-ink text-[14.5px] font-semibold hover:ring-accent/40 transition-colors"
      >
        Ver servicios
      </a>
    </div>
    <div class="mt-8 flex flex-wrap gap-2">
      {
        ['NFPA 99', 'ASSE 6000', 'ASSE 6010', 'ASSE 6030'].map((tag) => (
          <span class="text-[12px] font-mono font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-600 ring-1 ring-slate-200">
            {tag}
          </span>
        ))
      }
    </div>
  </div>

  <ImagePlaceholder caption="Sistema de Gases Medicinales" aspect="aspect-[4/3]" />
</section>
