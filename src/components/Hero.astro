---
import SanityImage from './SanityImage.astro';
import type { HeroSection } from '../lib/sanityQueries';
import { DEFAULT_HERO } from '../lib/content';
import heroRoom from '../assets/photos/hero-room.webp';
import NavyTexture from './NavyTexture.astro';
import { ShieldCheck } from 'lucide-react';
import GasFlowLine from './GasFlowLine.astro';

interface Props {
  hero: HeroSection | null;
}

const { hero } = Astro.props;
const eyebrow = hero?.eyebrow ?? DEFAULT_HERO.eyebrow;
const heading = hero?.heading ?? DEFAULT_HERO.heading;
const subheading = hero?.subheading ?? DEFAULT_HERO.subheading;
const ctaLabel = hero?.ctaLabel ?? DEFAULT_HERO.ctaLabel;
const ctaLink = hero?.ctaLink ?? DEFAULT_HERO.ctaLink;
---

<section
  id="inicio"
  class="from-accent-700 via-accent to-accent-400 seam-cut-bottom relative overflow-hidden bg-gradient-to-br"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span class="aurora-blob" style="--x:12%;--y:22%;--c:#2563eb;--d:0s"></span>
    <span class="aurora-blob" style="--x:82%;--y:26%;--c:#0d9488;--d:-6s"></span>
    <span class="aurora-blob" style="--x:55%;--y:82%;--c:#15803d;--d:-12s"></span>
  </div>
  <NavyTexture glow="#15803d33" />

  <div
    class="relative mx-auto grid w-full max-w-7xl items-center gap-14 px-5 pt-16 pb-28 md:px-9 md:pt-20 md:pb-36 lg:grid-cols-[1.1fr_0.9fr]"
  >
    <div>
      <span
        data-reveal
        class="text-2xs mb-6 inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 font-mono font-semibold text-white ring-1 ring-white/25 ring-inset"
      >
        {eyebrow}
      </span>
      {
        /* Sin `data-reveal`: este titular es el candidato a LCP de la portada y antes entraba
          palabra por palabra desde opacity 0 — diez spans escalonados, la última aterrizaba
          ~1.2s después de entrar en viewport, y el navegador no cuenta el LCP hasta que el
          elemento se pinta a su opacidad final. Pinta de una. El resto del hero (antetítulo,
          bajada, botones) conserva la entrada escalonada, así que la coreografía se mantiene
          alrededor del titular en vez de retrasarlo. */
      }
      <h1 class="font-display text-3xl leading-[1.1] font-extrabold tracking-tight text-white md:text-4xl">
        {heading}
      </h1>
      <p
        data-reveal
        data-reveal-delay="160"
        class="mt-6 max-w-[52ch] text-base leading-relaxed text-white/75 md:text-lg"
      >
        {subheading}
      </p>
      <div data-reveal data-reveal-delay="240" class="mt-9 flex flex-wrap gap-3">
        <a
          href={ctaLink}
          class="press-feedback focus-visible:ring-accent-200 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-[var(--color-accent-700)] shadow-lg shadow-black/20 transition-transform focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-accent)] focus-visible:outline-none motion-safe:hover:-translate-y-0.5"
        >
          {ctaLabel}
        </a>
        <a
          href="/servicios/"
          class="focus-visible:ring-accent-200 rounded-full border border-white/40 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-accent)] focus-visible:outline-none"
        >
          Ver servicios
        </a>
      </div>
      <GasFlowLine class="mt-10 max-w-xs" />
    </div>

    <div class="float-slow relative">
      <div class="rotate-[-2deg] rounded-2xl bg-white/95 p-3 shadow-2xl ring-1 ring-white/40 backdrop-blur">
        <SanityImage
          image={hero?.backgroundImage}
          alt="Sala hospitalaria con tomas de gases medicinales instaladas"
          caption="Sistema de Gases Medicinales"
          aspect="aspect-[4/3]"
          class="rounded-xl"
          fallback={heroRoom}
          priority
        />
      </div>

      <div
        class="bg-accent-700/90 absolute -bottom-6 left-2 rotate-[3deg] rounded-2xl px-5 py-4 shadow-xl ring-1 ring-white/20 backdrop-blur sm:-left-6"
      >
        <div class="text-2xs font-mono tracking-widest text-white/50 uppercase">Normativa</div>
        <div class="font-display mt-1 text-base font-bold text-white" translate="no">ASSE&nbsp;6000 · NFPA&nbsp;99</div>
      </div>

      <div
        class="absolute -top-5 -right-4 hidden h-14 w-14 rotate-[8deg] items-center justify-center rounded-full bg-white shadow-xl md:flex"
        aria-hidden="true"
      >
        <ShieldCheck size={22} color="#15803d" strokeWidth={2} />
      </div>
    </div>
  </div>
</section>
