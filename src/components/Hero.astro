---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { HeroSection } from '../lib/sanityQueries';
import { DEFAULT_HERO } from '../lib/content';

interface Props {
  hero: HeroSection | null;
}

const { hero } = Astro.props;
const eyebrow = hero?.eyebrow ?? DEFAULT_HERO.eyebrow;
const heading = hero?.heading ?? DEFAULT_HERO.heading;
const subheading = hero?.subheading ?? DEFAULT_HERO.subheading;
const ctaLabel = hero?.ctaLabel ?? DEFAULT_HERO.ctaLabel;
const ctaLink = hero?.ctaLink ?? DEFAULT_HERO.ctaLink;
---

<section id="inicio" class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 md:px-9 md:py-24 lg:grid-cols-2">
  <div>
    <div class="text-accent mb-4 text-[13px] font-semibold tracking-[0.08em] uppercase">{eyebrow}</div>
    <h1 class="font-display text-ink text-[32px] leading-[1.1] font-extrabold tracking-tight md:text-[44px]">
      {heading}
    </h1>
    <p class="mt-5 max-w-[52ch] text-[16px] leading-relaxed text-slate-600 md:text-[17px]">
      {subheading}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={ctaLink}
        class="bg-accent hover:bg-accent-600 rounded-lg px-6 py-3 text-[14.5px] font-semibold text-white transition-colors"
      >
        {ctaLabel}
      </a>
      <a
        href="#servicios"
        class="text-ink hover:ring-accent/40 rounded-lg px-6 py-3 text-[14.5px] font-semibold ring-1 ring-slate-200 transition-colors"
      >
        Ver servicios
      </a>
    </div>
    <div class="mt-8 flex flex-wrap gap-2">
      {
        ['NFPA 99', 'ASSE 6000', 'ASSE 6010', 'ASSE 6030'].map((tag) => (
          <span class="rounded-full bg-slate-100 px-3 py-1 font-mono text-[12px] font-semibold text-slate-600 ring-1 ring-slate-200">
            {tag}
          </span>
        ))
      }
    </div>
  </div>

  <ImagePlaceholder caption="Sistema de Gases Medicinales" aspect="aspect-[4/3]" />
</section>
