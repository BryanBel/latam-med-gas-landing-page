---
import { NAV_LINKS, DEFAULT_SITE_SETTINGS } from '../lib/content';
import { sanityImageUrl } from '../lib/sanityImage';
import type { SiteSettings } from '../lib/sanityQueries';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const siteName = settings?.siteName ?? DEFAULT_SITE_SETTINGS.siteName;
const logoUrl = sanityImageUrl(settings?.logo, 160);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-[76px] max-w-7xl items-center justify-between gap-6 px-5 md:px-9">
    <a href="#inicio" class="flex shrink-0 items-center gap-2">
      {
        logoUrl ? (
          <img src={logoUrl} alt={siteName} class="h-9 w-auto" />
        ) : (
          <span class="bg-accent font-display flex h-9 w-9 items-center justify-center rounded-lg text-[13px] font-bold text-white">
            LMG
          </span>
        )
      }
      <span class="font-display text-ink text-[16px] leading-none font-bold tracking-tight"> {siteName} </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      {
        NAV_LINKS.map((l) => (
          <a
            href={l.href}
            class="hover:text-accent focus-visible:ring-accent rounded-sm text-[14px] font-medium text-slate-600 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="bg-accent hover:bg-accent-600 rounded-lg px-4 py-2 text-[14px] font-semibold text-white transition-colors"
      >
        Contáctenos
      </a>
    </nav>

    <input type="checkbox" id="mobile-nav-toggle" class="peer hidden" />
    <label
      for="mobile-nav-toggle"
      class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg ring-1 ring-slate-200 lg:hidden"
      aria-label={`Abrir menú de ${siteName}`}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </label>

    <nav
      id="mobile-nav"
      class="absolute top-[76px] right-0 left-0 hidden flex-col gap-1 border-b border-slate-200 bg-white p-5 peer-checked:flex lg:hidden"
      aria-label="Navegación móvil"
    >
      {
        NAV_LINKS.map((l) => (
          <a href={l.href} class="hover:text-accent rounded-lg px-2 py-2.5 text-[15px] font-medium text-slate-600">
            {l.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="bg-accent mt-2 rounded-lg px-4 py-2.5 text-center text-[14px] font-semibold text-white"
      >
        Contáctenos
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle') as HTMLInputElement | null;
  const label = document.querySelector('label[for="mobile-nav-toggle"]');

  toggle?.addEventListener('change', () => {
    label?.setAttribute('aria-expanded', String(toggle.checked));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.checked) {
      toggle.checked = false;
      label?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
