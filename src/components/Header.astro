---
import { NAV_LINKS, DEFAULT_SITE_SETTINGS } from '../lib/content';
import { sanityImageUrl } from '../lib/sanityImage';
import type { SiteSettings } from '../lib/sanityQueries';
import lmgMark from '../assets/brand/lmg-mark.png';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const siteName = settings?.siteName ?? DEFAULT_SITE_SETTINGS.siteName;
const logoUrl = sanityImageUrl(settings?.logo, 160);
// Sanity gives no intrinsic height back from the URL builder, so reserve the rendered
// box (36px tall, the h-9 below) for that branch and the real dimensions for the local mark.
const logo = logoUrl ? { src: logoUrl, width: 160, height: 36 } : lmgMark;

const linkClass =
  'hover:text-accent focus-visible:ring-accent rounded-sm text-[14px] font-medium text-slate-600 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';
const ctaClass =
  'bg-accent hover:bg-accent-600 focus-visible:ring-accent rounded-full px-5 py-2 text-[14px] font-semibold text-white transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-[76px] max-w-7xl items-center justify-between gap-6 px-5 md:px-9">
    <a
      href="/#inicio"
      class="focus-visible:ring-accent flex min-w-0 items-center gap-2 rounded-sm focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      <img src={logo.src} alt="" width={logo.width} height={logo.height} class="h-9 w-auto shrink-0" />
      <span class="font-display text-ink truncate text-[16px] leading-none font-bold tracking-tight">{siteName}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      {
        NAV_LINKS.map((l) => (
          <a href={l.href} class={linkClass}>
            {l.label}
          </a>
        ))
      }
      <a href="/#contacto" class={ctaClass}>Contáctenos</a>
    </nav>

    <button
      type="button"
      id="mobile-nav-button"
      class="focus-visible:ring-accent flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg ring-1 ring-slate-200 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none lg:hidden"
      aria-label={`Abrir menú de ${siteName}`}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav
      id="mobile-nav"
      class="border-b-accent absolute top-[76px] right-0 left-0 hidden flex-col gap-1 border-b-[3px] bg-white p-5 shadow-lg shadow-slate-900/10 lg:hidden"
      aria-label="Navegación móvil"
    >
      {
        NAV_LINKS.map((l) => (
          <a
            href={l.href}
            class="hover:text-accent focus-visible:ring-accent rounded-lg px-2 py-2.5 text-[15px] font-medium text-slate-600 focus-visible:ring-2 focus-visible:outline-none focus-visible:ring-inset"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/#contacto"
        class="bg-accent focus-visible:ring-accent mt-2 rounded-full px-4 py-2.5 text-center text-[14px] font-semibold text-white focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        Contáctenos
      </a>
    </nav>
  </div>
</header>

<script>
  // Real <button> rather than a hidden checkbox + <label>: a display:none checkbox is
  // unfocusable, which left the mobile nav unreachable by keyboard entirely.
  const button = document.getElementById('mobile-nav-button');
  const nav = document.getElementById('mobile-nav');

  function setOpen(open: boolean) {
    button?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('hidden', !open);
    nav?.classList.toggle('flex', open);
  }

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
</script>
