---
import { NAV_LINKS, DEFAULT_SITE_SETTINGS } from '../lib/content';
import { sanityImageUrl } from '../lib/sanityImage';
import type { SiteSettings } from '../lib/sanityQueries';
import { getImage } from 'astro:assets';
import lmgMark from '../assets/brand/lmg-mark.png';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const siteName = settings?.siteName ?? DEFAULT_SITE_SETTINGS.siteName;
const logoUrl = sanityImageUrl(settings?.logo, 160);
// Sanity gives no intrinsic height back from the URL builder, so reserve the rendered
// box (36px tall, the h-9 below) for that branch and the real dimensions for the local mark.
// The seed mark is a 730x265 PNG rendered ~36px tall; served raw it was the heaviest
// asset on every page. astro:assets emits a webp at roughly 2x the rendered size instead.
let logo: { src: string; width: number; height: number };
if (logoUrl) {
  logo = { src: logoUrl, width: 160, height: 36 };
} else {
  const mark = await getImage({ src: lmgMark, width: 220, format: 'webp' });
  logo = { src: mark.src, width: 220, height: Math.round((220 * lmgMark.height) / lmgMark.width) };
}

const linkClass =
  "hover:text-accent focus-visible:ring-accent relative rounded-sm text-sm font-medium text-slate-600 transition-colors after:absolute after:-bottom-1 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 after:content-[''] hover:after:scale-x-100 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none motion-reduce:after:transition-none";
const ctaClass =
  'bg-accent hover:bg-accent-600 focus-visible:ring-accent rounded-full px-5 py-2 text-sm font-semibold text-white transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-[76px] max-w-7xl items-center justify-between gap-6 px-5 md:px-9">
    <a
      href="/"
      class="focus-visible:ring-accent flex min-w-0 items-center gap-2 rounded-sm focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      <img src={logo.src} alt="" width={logo.width} height={logo.height} class="h-9 w-auto shrink-0" />
      <span class="font-display text-ink truncate text-base leading-none font-bold tracking-tight">{siteName}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      {
        NAV_LINKS.map((l) => (
          <a href={l.href} class={linkClass}>
            {l.label}
          </a>
        ))
      }
      <a href="/contacto" class={ctaClass}>Contáctenos</a>
    </nav>

    <button
      type="button"
      id="mobile-nav-button"
      class="focus-visible:ring-accent flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg ring-1 ring-slate-200 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none lg:hidden"
      aria-label={`Abrir menú de ${siteName}`}
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav
      id="mobile-nav"
      class="border-b-accent absolute top-[76px] right-0 left-0 hidden flex-col gap-1 border-b-[3px] bg-white p-5 shadow-lg shadow-slate-900/10 lg:hidden"
      aria-label="Navegación móvil"
    >
      {
        NAV_LINKS.map((l) => (
          <a
            href={l.href}
            class="hover:text-accent focus-visible:ring-accent rounded-lg px-2 py-2.5 text-base font-medium text-slate-600 focus-visible:ring-2 focus-visible:outline-none focus-visible:ring-inset"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="bg-accent focus-visible:ring-accent mt-2 rounded-full px-4 py-2.5 text-center text-sm font-semibold text-white focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        Contáctenos
      </a>
    </nav>
  </div>
</header>

<!-- Mobile-nav toggle + Escape handling live in src/scripts/site.ts, which re-binds on every
     View Transitions navigation. The button is a real <button> so it stays keyboard-reachable. -->
