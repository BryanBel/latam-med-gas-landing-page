---
import ContactForm from './ContactForm';
import type { SiteSettings } from '../lib/sanityQueries';
import { DEFAULT_SITE_SETTINGS } from '../lib/content';
import SectionWedge from './SectionWedge.astro';
import { accentFor } from '../lib/icons';
import { Phone, Mail, MapPin } from 'lucide-react';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const phone = settings?.phone ?? DEFAULT_SITE_SETTINGS.phone;
const email = settings?.email ?? DEFAULT_SITE_SETTINGS.email;
const address = settings?.address ?? DEFAULT_SITE_SETTINGS.address;

// The client gave two numbers in one field ("+58 ... / +57 ..."); split them so each
// becomes its own tappable tel: link instead of one unclickable string.
const phoneLinks = phone
  .split('/')
  .map((p) => p.trim())
  .filter(Boolean)
  .map((p) => ({ href: `tel:${p.replace(/[^+\d]/g, '')}`, text: p }));

const CONTACT_ROWS = [
  { label: 'Teléfono', Icon: Phone, links: phoneLinks },
  { label: 'Correo', Icon: Mail, links: [{ href: `mailto:${email}`, text: email }] },
  { label: 'Dirección', Icon: MapPin, links: [], text: address },
];

const contactLinkClass =
  'hover:text-accent focus-visible:ring-accent rounded-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';
---

<section id="contacto" class="relative overflow-hidden">
  <SectionWedge edge="top" fill="bg-accent-600" textured />
  {
    /* Tighter vertical padding than the other sections: this one shares its screen with the
      footer, so the padding has to leave room for it. */
  }
  <div class="relative mx-auto w-full max-w-7xl px-5 py-10 md:px-9 md:py-12">
    <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="font-display text-ink mb-5 text-[28px] font-extrabold tracking-tight text-balance md:text-[34px]">
          Conversemos sobre su proyecto
        </h2>
        <p class="mb-8 text-[15px] leading-relaxed text-slate-600">
          Escríbanos y le responderemos con la información técnica y comercial que necesite.
        </p>

        <dl class="space-y-4">
          {
            CONTACT_ROWS.map(({ label, Icon, links, text }, i) => {
              const accent = accentFor(i);
              return (
                <div class="flex items-start gap-3.5">
                  <span
                    class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg"
                    style={{ backgroundColor: `${accent}1a` }}
                    aria-hidden="true"
                  >
                    <Icon size={16} color={accent} strokeWidth={2} aria-hidden="true" />
                  </span>
                  <div class="min-w-0">
                    <dt class="mb-0.5 text-[12px] font-semibold tracking-[0.08em] text-slate-500 uppercase">{label}</dt>
                    <dd class="text-ink text-[14.5px] leading-relaxed font-medium break-words">
                      {links.length > 0 ? (
                        <span class="flex flex-col gap-0.5">
                          {links.map((l) => (
                            <a href={l.href} class={contactLinkClass}>
                              {l.text}
                            </a>
                          ))}
                        </span>
                      ) : (
                        text
                      )}
                    </dd>
                  </div>
                </div>
              );
            })
          }
        </dl>
      </div>

      <div class="rounded-2xl bg-white p-7 ring-1 ring-slate-200 md:p-9">
        <ContactForm client:visible />
      </div>
    </div>
  </div>
</section>
