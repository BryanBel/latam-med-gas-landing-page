---
// La promesa de marca, en su propia franja.
//
// Antes vivía dentro de ContactCta, en 15px y cursiva, justo encima de un titular que compite
// con ella: dos mensajes apilados y el más débil arriba, así que se leía como pie de foto. Con
// franja propia cada uno tiene su turno.
//
// Va en azul y no en blanco. En blanco quedaba un bloque claro intercalado entre dos azules —
// en la portada, entre Trayectoria y la banda de contacto— que cortaba el cierre de la página
// en vez de construirlo. En azul, la franja y la banda de contacto se leen como un solo tramo
// final, con el eslogan como respiro antes del botón.
//
// El degradado empieza donde termina el de la sección de arriba: Trayectoria cierra en
// accent-400 abajo a la derecha, así que este arranca en accent-400 arriba a la izquierda y
// baja a accent-700, y la banda de contacto vuelve a subir. Sin eso, dos secciones azules
// seguidas muestran una línea horizontal donde el claro de una choca con el oscuro de la otra.
//
// El gráfico no es decorativo: la frase interrumpe un tramo de tubería, con dos nodos en rombo
// donde irían las válvulas. Es de lo que habla el eslogan y es de lo que vive la empresa.
//
// Sin cursiva a propósito. El sitio carga Figtree en 600/700/800 y Noto Sans en 400/500/600 —
// ninguna itálica — así que la cursiva anterior la sintetizaba el navegador inclinando los
// glifos, que es buena parte de por qué se veía barata.
import NavyTexture from './NavyTexture.astro';
import { DEFAULT_SITE_SETTINGS } from '../lib/content';
import type { SiteSettings } from '../lib/sanityQueries';

interface Props {
  settings?: SiteSettings | null;
  // Se pasa vacío en una página donde repetiría algo dicho justo arriba.
  text?: string;
}

const { settings } = Astro.props;
const text = Astro.props.text ?? settings?.slogan ?? DEFAULT_SITE_SETTINGS.slogan;
---

{
  text && (
    <section
      class="from-accent-400 via-accent to-accent-700 relative overflow-hidden bg-gradient-to-br"
      aria-label="Eslogan"
    >
      {/* Verde oxígeno, el color del gas que da nombre al negocio, y el único acento que no usa
        ninguna otra sección de cierre. */}
      <NavyTexture glow="#15803d2e" glowClass="-top-24 -right-20 h-[380px] w-[380px]" />

      <div class="relative mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-28">
        {/* Desde tablet la tubería atraviesa el ancho y la frase la interrumpe. */}
        <div class="hidden items-center md:flex" data-reveal>
          <div class="h-px flex-1 bg-gradient-to-r from-white/0 to-white/40" aria-hidden="true" />
          <div class="bg-accent-100 mx-5 size-[7px] shrink-0 rotate-45" aria-hidden="true" />
          <p class="font-display shrink-0 text-2xl leading-tight font-extrabold text-balance text-white lg:text-3xl">
            {text}
          </p>
          <div class="bg-accent-100 mx-5 size-[7px] shrink-0 rotate-45" aria-hidden="true" />
          <div class="h-px flex-1 bg-gradient-to-r from-white/40 to-white/0" aria-hidden="true" />
        </div>

        {/* En móvil la frase ocupa el ancho, así que el tramo de tubería se apila encima en
          lugar de partirse en dos trozos de pocos píxeles. */}
        <div class="text-center md:hidden" data-reveal>
          <div class="mb-4 flex items-center justify-center gap-3" aria-hidden="true">
            <div class="h-px w-14 bg-gradient-to-r from-white/0 to-white/45" />
            <div class="bg-accent-100 size-1.5 rotate-45" />
            <div class="h-px w-14 bg-gradient-to-r from-white/45 to-white/0" />
          </div>
          <p class="font-display text-xl leading-snug font-extrabold text-balance text-white">{text}</p>
        </div>
      </div>
    </section>
  )
}
