---
import SanityImage from './SanityImage.astro';
import type { AboutSection } from '../lib/sanityQueries';
import { DEFAULT_ABOUT } from '../lib/content';
import aboutCorridor from '../assets/photos/about-corridor.png';
import { accentFor } from '../lib/icons';
import { ShieldCheck, Globe2, Award, BadgeCheck } from 'lucide-react';

interface Props {
  about: AboutSection | null;
}

const { about } = Astro.props;
const eyebrow = about?.eyebrow ?? DEFAULT_ABOUT.eyebrow;
const heading = about?.heading ?? DEFAULT_ABOUT.heading;
const body = about?.body ?? DEFAULT_ABOUT.body;
const highlights = about?.highlights?.length ? about.highlights : DEFAULT_ABOUT.highlights;

const PILLAR_ICONS = [ShieldCheck, Globe2, Award];
---

<section id="nosotros" class="relative mx-auto max-w-7xl overflow-hidden px-5 py-20 md:px-9 md:py-24">
  <div
    class="pointer-events-none absolute -top-16 -left-24 h-[380px] w-[380px] rounded-full blur-3xl"
    aria-hidden="true"
    style={{ backgroundColor: '#0a0a8914' }}
  >
  </div>
  <div
    class="pointer-events-none absolute -right-20 bottom-0 h-[300px] w-[300px] rounded-full blur-3xl"
    aria-hidden="true"
    style={{ backgroundColor: '#15803d0f' }}
  >
  </div>

  <div class="relative grid items-center gap-12 lg:grid-cols-2">
    <div class="relative order-2 lg:order-1">
      <div class="rotate-[2deg] rounded-2xl bg-white p-3 shadow-xl shadow-slate-200/70 ring-1 ring-slate-100">
        <SanityImage
          image={about?.image}
          alt={heading}
          caption="Latam Med Gas"
          aspect="aspect-[4/3]"
          class="rounded-xl"
          fallbackSrc={aboutCorridor.src}
        />
      </div>
      <div
        class="bg-accent-700 absolute -bottom-5 -left-4 hidden -rotate-3 items-center gap-2 rounded-xl px-4 py-3 shadow-lg sm:flex"
      >
        <BadgeCheck size={18} color="#ffffff" strokeWidth={2} />
        <span class="font-display text-[13px] font-bold text-white">ASSE · NFPA 99</span>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <div class="text-accent mb-3 text-[13px] font-semibold tracking-[0.08em] uppercase">{eyebrow}</div>
      <h2 class="font-display text-ink text-[28px] font-extrabold tracking-tight md:text-[34px]">{heading}</h2>
      <p class="mt-5 text-[15px] leading-relaxed text-slate-600">{body}</p>
    </div>
  </div>

  <div class="mt-14 grid gap-5 sm:grid-cols-3">
    {
      highlights.map((h, i) => {
        const Icon = PILLAR_ICONS[i % PILLAR_ICONS.length];
        const accent = accentFor(i);
        return (
          <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
            <div
              class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg"
              style={{ backgroundColor: `${accent}1a` }}
            >
              <Icon size={20} color={accent} strokeWidth={2} />
            </div>
            <p class="text-[14px] leading-relaxed text-slate-600">{h}</p>
          </div>
        );
      })
    }
  </div>
</section>
