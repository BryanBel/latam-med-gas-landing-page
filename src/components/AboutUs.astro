---
import SanityImage from './SanityImage.astro';
import type { AboutSection } from '../lib/sanityQueries';
import { DEFAULT_ABOUT } from '../lib/content';
import aboutCorridor from '../assets/photos/about-corridor.png';
import SectionWedge from './SectionWedge.astro';
import MissionVision from './MissionVision.astro';
import { accentFor } from '../lib/icons';
import { ShieldCheck, Globe2, Award, BadgeCheck } from 'lucide-react';

interface Props {
  about: AboutSection | null;
}

const { about } = Astro.props;
const heading = about?.heading ?? DEFAULT_ABOUT.heading;
const body = about?.body ?? DEFAULT_ABOUT.body;
const highlights = about?.highlights?.length ? about.highlights : DEFAULT_ABOUT.highlights;

const PILLAR_ICONS = [ShieldCheck, Globe2, Award];
---

<section id="nosotros" class="relative overflow-hidden">
  {
    /* Inicio's diagonal continuing below the seam, then the same cut again where Servicios
      starts. Both navy halves are textured so the dot field carries through the wedge. */
  }
  <SectionWedge edge="top" fill="bg-accent" textured />
  <SectionWedge edge="bottom" fill="bg-accent-600" textured />
  <div
    class="pointer-events-none absolute -top-16 -left-24 h-[380px] w-[380px] rounded-full blur-3xl"
    aria-hidden="true"
    style={{ backgroundColor: '#0a0a8914' }}
  >
  </div>
  <div
    class="pointer-events-none absolute -right-20 bottom-0 h-[300px] w-[300px] rounded-full blur-3xl"
    aria-hidden="true"
    style={{ backgroundColor: '#15803d0f' }}
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-5 pt-24 pb-20 md:px-9 md:pt-28 md:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="relative order-2 lg:order-1" data-reveal>
        <div class="rotate-[2deg] rounded-2xl bg-white p-3 shadow-xl ring-1 shadow-slate-200/70 ring-slate-100">
          <SanityImage
            image={about?.image}
            alt="Pasillo hospitalario con red de gases medicinales instalada"
            caption="Latam Med Gas"
            aspect="aspect-[4/3]"
            class="rounded-xl"
            fallbackSrc={aboutCorridor.src}
          />
        </div>
        <div
          class="bg-accent-700 absolute -bottom-5 -left-4 hidden -rotate-3 items-center gap-2 rounded-xl px-4 py-3 shadow-lg sm:flex"
        >
          <BadgeCheck size={18} color="#ffffff" strokeWidth={2} aria-hidden="true" />
          <span class="font-display text-xs font-bold text-white" translate="no">ASSE · NFPA&nbsp;99</span>
        </div>
      </div>

      <div class="order-1 lg:order-2" data-reveal>
        <h2 class="font-display text-ink text-2xl font-extrabold tracking-tight text-balance md:text-3xl">
          {heading}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-slate-600">{body}</p>

        {
          /* Was a band of three equal cards below the section, which is the textbook
            "three identical feature cards" block. These are supporting facts about the
            company, so they belong with the company copy: one column, hairline-separated,
            no card chrome. */
        }
        <ul class="mt-8 divide-y divide-slate-200 border-t border-slate-200">
          {
            highlights.map((h, i) => {
              const Icon = PILLAR_ICONS[i % PILLAR_ICONS.length];
              const accent = accentFor(i);
              return (
                <li class="flex items-start gap-3.5 py-4">
                  <div
                    class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg"
                    style={{ backgroundColor: `${accent}1a` }}
                    aria-hidden="true"
                  >
                    <Icon size={18} color={accent} strokeWidth={2} aria-hidden="true" />
                  </div>
                  <p class="min-w-0 text-sm leading-relaxed text-slate-600">{h}</p>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 md:mt-20">
      <MissionVision />
    </div>
  </div>
</section>
