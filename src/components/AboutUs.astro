---
// Home "Nosotros" teaser — a taste of the company that links to the full /nosotros page.
// The full copy, highlights, misión/visión and normativas live on /nosotros.
import SanityImage from './SanityImage.astro';
import type { AboutSection } from '../lib/sanityQueries';
import { DEFAULT_ABOUT } from '../lib/content';
import aboutCorridor from '../assets/photos/about-corridor.png';
import { BadgeCheck, ArrowRight } from 'lucide-react';

interface Props {
  about: AboutSection | null;
}

const { about } = Astro.props;
const heading = about?.heading ?? DEFAULT_ABOUT.heading;
const body = about?.body ?? DEFAULT_ABOUT.body;
---

<section id="nosotros" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -top-16 -left-24 h-[380px] w-[380px] rounded-full blur-3xl"
    aria-hidden="true"
    style={{ backgroundColor: '#0a0a8914' }}
  >
  </div>
  <div
    class="pointer-events-none absolute -right-20 bottom-0 h-[300px] w-[300px] rounded-full blur-3xl"
    aria-hidden="true"
    style={{ backgroundColor: '#15803d0f' }}
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-5 pt-24 pb-20 md:px-9 md:pt-28 md:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="relative order-2 lg:order-1" data-reveal>
        <div class="rotate-[2deg] rounded-2xl bg-white p-3 shadow-xl ring-1 shadow-slate-200/70 ring-slate-100">
          <SanityImage
            image={about?.image}
            alt="Pasillo hospitalario con red de gases medicinales instalada"
            caption="Latam Med Gas"
            aspect="aspect-[4/3]"
            class="rounded-xl"
            fallback={aboutCorridor}
          />
        </div>
        <div
          class="bg-accent-700 absolute -bottom-5 -left-4 hidden -rotate-3 items-center gap-2 rounded-xl px-4 py-3 shadow-lg sm:flex"
        >
          <BadgeCheck size={18} color="#ffffff" strokeWidth={2} aria-hidden="true" />
          <span class="font-display text-xs font-bold text-white" translate="no">ASSE · NFPA&nbsp;99</span>
        </div>
      </div>

      <div class="order-1 lg:order-2" data-reveal>
        <div class="text-accent mb-3 text-xs font-semibold tracking-[0.08em] uppercase">Nosotros</div>
        <h2 class="font-display text-ink text-2xl font-extrabold tracking-tight text-balance md:text-3xl">
          {heading}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-slate-600">{body}</p>
        <a
          href="/nosotros/"
          class="press-feedback bg-accent hover:bg-accent-600 focus-visible:ring-accent mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none [&_svg]:transition-transform [&_svg]:duration-200 hover:[&_svg]:translate-x-1 motion-reduce:[&_svg]:transform-none"
        >
          Conócenos
          <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
