---
// Misión / Visión pair. Light cards, sits inside the Nosotros section.
//
// Comparten el tratamiento del resto de tarjetas del sitio — inclinación al pasar el puntero,
// elevación y aro de acento. Eran las únicas dos que se quedaban quietas, lo que las hacía
// parecer un bloque de texto enmarcado en vez de una tarjeta como las demás.
import { DEFAULT_MISSION_VISION } from '../lib/content';
import { Target, Eye } from 'lucide-react';

interface Props {
  mission?: string;
  vision?: string;
}
const { mission = DEFAULT_MISSION_VISION.mission, vision = DEFAULT_MISSION_VISION.vision } = Astro.props;

const CARDS = [
  { label: 'Misión', body: mission, Icon: Target, accent: '#15803d' },
  { label: 'Visión', body: vision, Icon: Eye, accent: '#2563eb' },
];
---

<div class="grid gap-5 md:grid-cols-2">
  {CARDS.map(({ label, body, Icon, accent }, i) => (
    <div
      data-reveal
      data-tilt
      data-reveal-delay={i * 90}
      class="group hover:ring-accent-200 rounded-2xl bg-white p-7 ring-1 ring-slate-200 transition-[transform,box-shadow] hover:shadow-lg hover:shadow-slate-200/60 motion-safe:hover:-translate-y-0.5"
    >
      <div class="mb-4 flex items-center gap-3">
        <span
          class="flex h-11 w-11 items-center justify-center rounded-xl transition-transform motion-safe:group-hover:scale-105"
          style={{ backgroundColor: `${accent}1a` }}
          aria-hidden="true"
        >
          <Icon size={20} color={accent} strokeWidth={2} aria-hidden="true" />
        </span>
        <h3 class="font-display text-ink text-xl font-bold">{label}</h3>
      </div>
      <p class="text-sm leading-relaxed text-slate-600">{body}</p>
    </div>
  ))}
</div>
