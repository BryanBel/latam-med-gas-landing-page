---
import { NAV_LINKS, DEFAULT_SITE_SETTINGS } from '../lib/content';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div
    class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-12 md:flex-row md:items-center md:px-9"
  >
    <div>
      <div class="flex items-center gap-2">
        <span
          class="bg-accent font-display flex h-8 w-8 items-center justify-center rounded-lg text-[12px] font-bold text-white"
        >
          LMG
        </span>
        <span class="font-display text-ink text-[15px] font-bold">{DEFAULT_SITE_SETTINGS.siteName}</span>
      </div>
      <p class="mt-2 max-w-[46ch] text-[13px] text-slate-500">{DEFAULT_SITE_SETTINGS.tagline}</p>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Enlaces del pie de página">
      {
        NAV_LINKS.map((l) => (
          <a href={l.href} class="hover:text-accent text-[13.5px] font-medium text-slate-600 transition-colors">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="border-t border-slate-200">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-2 px-5 py-5 text-[12.5px] text-slate-500 sm:flex-row sm:items-center md:px-9"
    >
      <span>© {year} {DEFAULT_SITE_SETTINGS.siteName}. Todos los derechos reservados.</span>
      <span>Sus datos de contacto se utilizan únicamente para responder a su solicitud.</span>
    </div>
  </div>
</footer>
