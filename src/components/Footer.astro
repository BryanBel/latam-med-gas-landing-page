---
import { NAV_LINKS, DEFAULT_SITE_SETTINGS } from '../lib/content';
import { sanityImageUrl } from '../lib/sanityImage';
import type { SiteSettings } from '../lib/sanityQueries';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const siteName = settings?.siteName ?? DEFAULT_SITE_SETTINGS.siteName;
const tagline = settings?.tagline ?? DEFAULT_SITE_SETTINGS.tagline;
const logoUrl = sanityImageUrl(settings?.logo, 140);
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div
    class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-12 md:flex-row md:items-center md:px-9"
  >
    <div>
      <div class="flex items-center gap-2">
        {
          logoUrl ? (
            <img src={logoUrl} alt={siteName} class="h-8 w-auto" />
          ) : (
            <span class="bg-accent font-display flex h-8 w-8 items-center justify-center rounded-lg text-[12px] font-bold text-white">
              LMG
            </span>
          )
        }
        <span class="font-display text-ink text-[15px] font-bold">{siteName}</span>
      </div>
      <p class="mt-2 max-w-[46ch] text-[13px] text-slate-500">{tagline}</p>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Enlaces del pie de página">
      {
        NAV_LINKS.map((l) => (
          <a href={l.href} class="hover:text-accent text-[13.5px] font-medium text-slate-600 transition-colors">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="border-t border-slate-200">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-2 px-5 py-5 text-[12.5px] text-slate-500 sm:flex-row sm:items-center md:px-9"
    >
      <span>© {year} {siteName}. Todos los derechos reservados.</span>
      <span>Sus datos de contacto se utilizan únicamente para responder a su solicitud.</span>
    </div>
  </div>
</footer>
