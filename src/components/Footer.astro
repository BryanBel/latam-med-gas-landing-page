---
import { NAV_LINKS, DEFAULT_SITE_SETTINGS } from '../lib/content';
import { sanityImageUrl } from '../lib/sanityImage';
import type { SiteSettings } from '../lib/sanityQueries';
import { getImage } from 'astro:assets';
import lmgMark from '../assets/brand/lmg-mark.webp';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const siteName = settings?.siteName ?? DEFAULT_SITE_SETTINGS.siteName;
const navLinks = settings?.navLinks?.length ? settings.navLinks : NAV_LINKS;
const tagline = settings?.tagline ?? DEFAULT_SITE_SETTINGS.tagline;
const footerNote = settings?.footerNote ?? DEFAULT_SITE_SETTINGS.footerNote;

// Teléfono y correo en el pie, no solo en /contacto/. Un responsable de mantenimiento que
// quiere llamar no debería tener que navegar a otra página para encontrar el número — y en
// venta B2B internacional el teléfono visible es parte de parecer una empresa localizable.
// El mismo criterio de división que la página de Contacto: el cliente dio dos números en un
// solo campo, así que cada uno va como su propio enlace `tel:`.
const phone = settings?.phone ?? DEFAULT_SITE_SETTINGS.phone;
const email = settings?.email ?? DEFAULT_SITE_SETTINGS.email;
const phoneLinks = phone
  .split('/')
  .map((p) => p.trim())
  .filter(Boolean)
  .map((p) => ({ href: `tel:${p.replace(/[^+\d]/g, '')}`, text: p }));
// La dirección completa son 80 caracteres y ya está en /contacto/ y en el JSON-LD. Aquí basta
// la ciudad: dice dónde está la empresa sin convertir el pie en una ficha postal.
const ciudad = 'Miami, Florida · Estados Unidos';

// «Contáctenos» no viaja en NAV_LINKS porque la cabecera lo pinta como botón aparte; en el pie
// es un enlace más de la lista.
const footerNav = [...navLinks, { href: '/contacto/', label: 'Contáctenos' }];
const footerNavLink =
  'hover:text-accent focus-visible:ring-accent rounded-sm text-xs font-medium text-slate-600 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';

const footerLink =
  'hover:text-accent focus-visible:ring-accent rounded-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';
const logoUrl = sanityImageUrl(settings?.logo, 140);
// Same reasoning as Header: Sanity returns no intrinsic height, so reserve the rendered box.
// The seed mark is a 730x265 PNG rendered ~36px tall; served raw it was the heaviest
// asset on every page. astro:assets emits a webp at roughly 2x the rendered size instead.
let logo: { src: string; width: number; height: number };
if (logoUrl) {
  logo = { src: logoUrl, width: 140, height: 32 };
} else {
  const mark = await getImage({ src: lmgMark, width: 200, format: 'webp' });
  logo = { src: mark.src, width: 200, height: Math.round((200 * lmgMark.height) / lmgMark.width) };
}
const year = new Date().getFullYear();

// `role="contentinfo"` is redundant now and kept on purpose. It was load-bearing while the
// footer sat inside <main>, where the implicit landmark is dropped; that was fixed on
// 2026-09-23 and every page now renders it as a sibling of main. Keeping the explicit role
// costs nothing and means a future layout change cannot silently take the landmark away again.
---

<footer role="contentinfo" class="bg-slate-50">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 md:grid-cols-[1.4fr_1fr_auto] md:gap-12 md:px-9 lg:gap-16">
    <div>
      <div class="flex items-center gap-2">
        <img src={logo.src} alt="" width={logo.width} height={logo.height} class="h-8 w-auto shrink-0" />
        <span class="font-display text-ink text-base font-bold">{siteName}</span>
      </div>
      <p class="mt-2 max-w-[46ch] text-xs text-slate-500">{tagline}</p>
    </div>

    <div>
      <h2 class="text-2xs text-ink mb-3 font-semibold tracking-[0.08em] uppercase">Contacto</h2>
      <ul class="space-y-1.5 text-xs text-slate-600">
        {phoneLinks.map((p) => (
          <li>
            <a href={p.href} class={footerLink}>
              {p.text}
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${email}`} class:list={[footerLink, 'break-all']}>
            {email}
          </a>
        </li>
        <li class="text-slate-500">{ciudad}</li>
      </ul>
    </div>

    {/* Los seis enlaces, en dos columnas. Apilados en una sola eran lo que estiraba el pie
        —seis filas seguidas— mientras la columna de la marca se quedaba medio vacía justo al
        lado. Repartidos, las tres secciones acaban a una altura parecida y el pie pierde unos
        70 px sin perder nada de contenido.

        Y va como lista, que es lo que es: un lector de pantalla anuncia «seis elementos» en
        vez de recitarlos sueltos. */}
    <nav aria-labelledby="footer-nav-titulo">
      <h2 id="footer-nav-titulo" class="text-2xs text-ink mb-3 font-semibold tracking-[0.08em] uppercase">
        Navegación
      </h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2">
        {footerNav.map((l) => (
          <li>
            <a href={l.href} class={footerNavLink}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-200">
    <div class="text-2xs mx-auto flex max-w-7xl flex-col items-start justify-between gap-2 px-5 py-5 text-slate-500 sm:flex-row sm:items-center md:px-9">
      <span>
        © {year} {siteName}. Todos los derechos reservados.
      </span>
      <span class="flex flex-wrap items-center gap-x-2">
        {footerNote}
        <a
          href="/privacidad/"
          class="hover:text-accent focus-visible:ring-accent rounded-sm font-medium underline underline-offset-2 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Política de Privacidad
        </a>
      </span>
    </div>
  </div>
</footer>
