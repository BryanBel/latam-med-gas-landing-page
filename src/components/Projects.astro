---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { Project } from '../lib/sanityQueries';
import { DEFAULT_PROJECTS } from '../lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const items = projects.length > 0 ? projects : DEFAULT_PROJECTS;
---

<section id="proyectos" class="border-y border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-9 md:py-24">
    <div class="mb-12 max-w-2xl">
      <div class="text-accent mb-3 text-[13px] font-semibold tracking-[0.08em] uppercase">Proyectos</div>
      <h2 class="font-display text-ink text-[28px] font-extrabold tracking-tight md:text-[34px]">
        Instituciones que confían en nuestro trabajo
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        items.map((p) => (
          <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200">
            <ImagePlaceholder caption={p.clientName} aspect="aspect-[21/9]" />
            <div class="p-7">
              <h3 class="font-display text-ink mb-1 text-[18px] font-bold">{p.clientName}</h3>
              {p.location && <p class="mb-3 text-[12.5px] font-medium text-slate-500">{p.location}</p>}
              <p class="text-[14px] leading-relaxed text-slate-600">{p.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
