---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { Project } from '../lib/sanity-queries';
import { DEFAULT_PROJECTS } from '../lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const items = projects.length > 0 ? projects : DEFAULT_PROJECTS;
---

<section id="proyectos" class="bg-slate-50 border-y border-slate-200">
  <div class="max-w-7xl mx-auto px-5 md:px-9 py-20 md:py-24">
    <div class="max-w-2xl mb-12">
      <div class="text-[13px] font-semibold text-accent uppercase tracking-[0.08em] mb-3">Proyectos</div>
      <h2 class="font-display font-extrabold text-[28px] md:text-[34px] text-ink tracking-tight">
        Instituciones que confían en nuestro trabajo
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {
        items.map((p) => (
          <div class="rounded-2xl bg-white ring-1 ring-slate-200 overflow-hidden">
            <ImagePlaceholder caption={p.clientName} aspect="aspect-[21/9]" />
            <div class="p-7">
              <h3 class="font-display font-bold text-[18px] text-ink mb-1">{p.clientName}</h3>
              {p.location && <p class="text-[12.5px] text-slate-500 font-medium mb-3">{p.location}</p>}
              <p class="text-[14px] text-slate-600 leading-relaxed">{p.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
