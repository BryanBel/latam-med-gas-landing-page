---
import SanityImage from './SanityImage.astro';
import NavyTexture from './NavyTexture.astro';
import StatStrip from './StatStrip.astro';
import type { Project, Stat } from '../lib/sanityQueries';
import { DEFAULT_PROJECTS, DEFAULT_PAGES } from '../lib/content';
import projectVerification from '../assets/photos/project-verification-room.webp';
import projectPediatric from '../assets/photos/project-pediatric-headwall.webp';
import { ArrowRight } from 'lucide-react';

interface Props {
  projects: Project[];
  // Home shows a few highlights and links on to /trayectoria; the full list lives there.
  limit?: number;
  moreHref?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  ctaLabel?: string;
  stats?: Stat[];
  // Sin fondo ni trama propios: la sección va dentro de un tramo azul que ya los pone. Es lo
  // que permite que Trayectoria, el eslogan y la banda de contacto sean una sola superficie en
  // la portada en vez de tres bloques con costura visible entre ellos.
  bare?: boolean;
}

const {
  projects,
  limit,
  moreHref,
  eyebrow = 'Trayectoria',
  heading = DEFAULT_PAGES.inicio.sections?.proyectos?.heading,
  subheading = DEFAULT_PAGES.inicio.sections?.proyectos?.subheading,
  ctaLabel = DEFAULT_PAGES.inicio.sections?.proyectos?.ctaLabel,
  stats,
  bare = false,
} = Astro.props;
const source = projects.length > 0 ? projects : DEFAULT_PROJECTS;
const items = limit ? source.slice(0, limit) : source;
// Shown for any project (seed or real Sanity doc) that doesn't have its own uploaded image yet.
// Cada una lleva su propio alt: describe la foto que se ve, no el hospital de la ficha, que es
// otro sitio. En cuanto el cliente suba la foto real del proyecto, el alt pasa a ser el nombre
// del hospital, que entonces sí es cierto.
const fallbackPhotos = [
  { src: projectVerification, alt: 'Sala hospitalaria durante la verificación de su sistema de gases medicinales' },
  { src: projectPediatric, alt: 'Cabecero hospitalario con tomas de gases medicinales instaladas' },
];
---

<section
  id="proyectos"
  class:list={[
    'relative overflow-hidden',
    !bare && 'from-accent-700 via-accent to-accent-400 seam-cut-top bg-gradient-to-br',
  ]}
>
  {!bare && <NavyTexture glow="#0d948833" glowClass="-top-20 -right-20 h-[380px] w-[380px]" />}

  <div class="relative mx-auto w-full max-w-7xl px-5 py-20 md:px-9 md:py-24">
    <div class="mb-12 max-w-2xl" data-reveal>
      <div class="text-accent-100 mb-3 text-xs font-semibold tracking-[0.08em] uppercase">{eyebrow}</div>
      <h2 class="font-display text-2xl font-extrabold tracking-tight text-balance text-white md:text-3xl">
        {heading}
      </h2>
      {subheading && <p class="mt-3 text-base text-white/75">{subheading}</p>}
    </div>

    <StatStrip class="mb-16" stats={stats} />

    <div class="grid gap-6 md:grid-cols-2">
      {
        items.map((p, i) => (
          <div
            data-reveal
            data-tilt
            data-reveal-delay={(i % 2) * 100}
            class="group hover:ring-accent-200 overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200 transition-[transform,box-shadow] hover:shadow-lg hover:shadow-slate-200/60 motion-safe:hover:-translate-y-0.5"
          >
            <div class="relative">
              <SanityImage
                image={p.image}
                alt={p.clientName}
                caption={p.clientName}
                aspect="aspect-21/9"
                fallback={fallbackPhotos[i % fallbackPhotos.length].src}
                fallbackAlt={fallbackPhotos[i % fallbackPhotos.length].alt}
              />
              {p.serviceType && (
                <span class="text-accent-700 font-display text-2xs absolute top-4 left-4 rounded-full bg-white/90 px-2.5 py-1 font-bold backdrop-blur">
                  {p.serviceType}
                </span>
              )}
            </div>
            <div class="p-7">
              <h3 class="font-display text-ink mb-1 text-xl font-bold">{p.clientName}</h3>
              {(p.location || p.country || p.date) && (
                <p class="text-2xs mb-3 font-medium text-slate-500">
                  {[p.location, p.country].filter(Boolean).join(', ')}
                  {p.date && ` · ${p.date}`}
                </p>
              )}
              <p class="text-sm leading-relaxed text-slate-600">{p.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    {
      moreHref && (
        <div class="mt-10" data-reveal>
          <a
            href={moreHref}
            class="press-feedback focus-visible:ring-accent-200 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-[var(--color-accent-700)] shadow-lg shadow-black/20 transition-transform focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-accent)] focus-visible:outline-none motion-safe:hover:-translate-y-0.5 [&_svg]:transition-transform [&_svg]:duration-200 hover:[&_svg]:translate-x-1 motion-reduce:[&_svg]:transform-none"
          >
            {ctaLabel}
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>
        </div>
      )
    }
  </div>
</section>
